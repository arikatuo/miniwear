.weather-form { margin-top: 34rpx; }
.temperature-input { display: flex; align-items: center; padding: 0 22rpx; background: #f7fafc; border: 1rpx solid #dce8f2; border-radius: 18rpx; }
.temperature-input input { flex: 1; min-height: 92rpx; color: #253342; font-size: 42rpx; font-weight: 650; }
.spaced { margin-top: 30rpx; }
.weather-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.weather-options button { min-height: 78rpx; margin: 0; color: #526678; background: #f2f6f9; border-radius: 18rpx; font-size: 27rpx; line-height: 78rpx; }
.weather-options button.active { color: #ffffff; background: #3478b9; }
.submit { margin-top: 30rpx; }
button::after { border: 0; }
