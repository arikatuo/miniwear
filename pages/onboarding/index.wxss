.onboarding {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  padding-bottom: calc(38rpx + env(safe-area-inset-bottom));
}

.onboarding-ambient {
  position: absolute;
  z-index: 0;
  border-radius: 999rpx;
  opacity: 0.65;
}

.onboarding-ambient.one {
  top: 210rpx;
  right: -120rpx;
  width: 280rpx;
  height: 280rpx;
  background: #dceff0;
}

.onboarding-ambient.two {
  bottom: 260rpx;
  left: -110rpx;
  width: 250rpx;
  height: 250rpx;
  background: #ffe9c2;
}

.progress-shell,
.hero-copy,
.illustration,
.selection-card,
.temperature-panel,
.form-card,
.footer-actions,
.skip {
  position: relative;
  z-index: 1;
}

.progress-shell {
  margin-top: 8rpx;
}

.progress {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.58);
  border-radius: 999rpx;
}

.progress-item {
  flex: 1;
  height: 10rpx;
  background: rgba(47, 111, 159, 0.12);
  border-radius: 999rpx;
  transition: background 220ms ease;
}

.progress-item.active {
  background: linear-gradient(90deg, #2f6f9f, #74aeca);
  box-shadow: 0 6rpx 18rpx rgba(47, 111, 159, 0.2);
}

.step-label {
  color: var(--color-faint);
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.hero-copy {
  margin-top: 28rpx;
}

.illustration {
  height: 292rpx;
  margin: 38rpx 0 26rpx;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(231, 244, 249, 0.96), rgba(255, 248, 234, 0.92));
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 38rpx;
  box-shadow: var(--shadow-soft);
}

.sun-orb {
  position: absolute;
  top: 48rpx;
  right: 74rpx;
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(145deg, #ffe6a5, #ffd06d);
  border-radius: 50%;
  box-shadow: 0 16rpx 40rpx rgba(217, 163, 95, 0.25);
}

.building {
  position: absolute;
  bottom: 0;
  background: linear-gradient(180deg, #8fbfda, #6fa6c8);
  border-radius: 22rpx 22rpx 0 0;
}

.building.one {
  left: 82rpx;
  width: 114rpx;
  height: 134rpx;
  opacity: 0.88;
}

.building.two {
  left: 230rpx;
  width: 154rpx;
  height: 196rpx;
  background: linear-gradient(180deg, #6ea8cf, #4f8cba);
}

.building.three {
  right: 84rpx;
  width: 126rpx;
  height: 112rpx;
  background: linear-gradient(180deg, #b9d8e8, #93bed6);
}

.city-line {
  position: absolute;
  right: 40rpx;
  bottom: 0;
  left: 40rpx;
  height: 2rpx;
  background: rgba(47, 111, 159, 0.12);
}

.selection-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 32rpx;
  box-shadow: var(--shadow-soft);
}

.selection-label {
  display: block;
  color: var(--color-faint);
  font-size: 23rpx;
  font-weight: 700;
}

.selection-value {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text);
  font-size: 36rpx;
  font-weight: 800;
}

.selection-action {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 750;
}

.temperature-panel {
  margin-top: 42rpx;
  padding: 34rpx 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 38rpx;
  box-shadow: var(--shadow-lift);
}

.temperature-readout {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-bottom: 24rpx;
  color: var(--color-primary);
  font-weight: 850;
  line-height: 1;
}

.temperature-readout text:first-child {
  font-size: 116rpx;
  letter-spacing: -0.06em;
}

.temperature-readout .unit {
  margin-top: 18rpx;
  font-size: 42rpx;
}

.wheel-wrap,
.settings-temp-wheel {
  position: relative;
  overflow: hidden;
  height: 260rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(245, 248, 246, 0.3), rgba(231, 242, 247, 0.8), rgba(245, 248, 246, 0.3));
}

.wheel-highlight {
  position: absolute;
  top: 90rpx;
  right: 24rpx;
  left: 24rpx;
  height: 80rpx;
  border: 1rpx solid rgba(47, 111, 159, 0.12);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.temperature-wheel {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 260rpx;
}

.wheel-item {
  display: flex;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  color: var(--color-primary-deep);
  font-size: 40rpx;
  font-weight: 800;
}

.panel-note {
  display: block;
  margin-top: 20rpx;
  color: var(--color-faint);
  font-size: 24rpx;
  text-align: center;
}

.form-card {
  margin-top: 36rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 38rpx;
  box-shadow: var(--shadow-soft);
}

.picker-value {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  color: var(--color-muted);
  background: var(--color-surface-soft);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}

.spaced {
  margin-top: 32rpx;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.option {
  min-height: 86rpx;
  margin: 0;
  padding: 0;
  color: var(--color-muted);
  background: #f2f6f6;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 86rpx;
}

.option.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-primary), #4a92bd);
  box-shadow: 0 16rpx 32rpx rgba(47, 111, 159, 0.18);
}

.footer-actions {
  display: flex;
  gap: 18rpx;
  margin-top: auto;
  padding-top: 44rpx;
}

.half {
  width: 230rpx;
  margin: 0;
}

.grow {
  flex: 1;
  margin: 0;
}

.skip {
  min-height: 76rpx;
  margin-top: 16rpx;
  color: var(--color-muted);
  background: transparent;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
}
