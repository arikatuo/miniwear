.onboarding {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  padding-bottom: calc(38rpx + env(safe-area-inset-bottom));
}

.progress-shell { margin-top: 4rpx; }

.progress {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 6rpx;
  background: var(--color-surface);
  border-radius: 999rpx;
}

.progress-item {
  flex: 1;
  height: 10rpx;
  background: var(--color-border);
  border-radius: 999rpx;
  transition: background 220ms ease;
}

.progress-item.active {
  background: linear-gradient(90deg, var(--color-coral), var(--color-butter));
  box-shadow: 0 6rpx 18rpx rgba(255, 138, 101, 0.25);
}

.step-label {
  color: var(--color-faint);
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.hero-copy { margin-top: 26rpx; }

.illustration {
  display: flex;
  height: 280rpx;
  margin: 34rpx 0 26rpx;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, var(--color-sky-soft), var(--color-butter-soft));
  border-radius: 40rpx;
  box-shadow: var(--shadow-soft);
}

.mascot-img { width: 320rpx; height: 226rpx; }

.selection-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 28rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: 32rpx;
  box-shadow: var(--shadow-soft);
}

.selection-icon-wrap {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  background: var(--color-coral-soft);
  border-radius: 22rpx;
}

.selection-icon { width: 46rpx; height: 46rpx; }
.selection-text { flex: 1; min-width: 0; }
.selection-label { display: block; color: var(--color-faint); font-size: 23rpx; font-weight: 700; }
.selection-value { display: block; margin-top: 4rpx; color: var(--color-ink); font-size: 34rpx; font-weight: 750; }
.selection-action { flex: none; color: var(--color-coral-deep); font-size: 25rpx; font-weight: 700; }

.temperature-panel {
  margin-top: 36rpx;
  padding: 34rpx 30rpx 30rpx;
  text-align: center;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: 40rpx;
  box-shadow: var(--shadow-lift);
}

.thermo-icon { width: 64rpx; height: 64rpx; margin: 0 auto; }

.temperature-readout {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin: 6rpx 0 24rpx;
  color: var(--color-coral-deep);
  font-weight: 800;
  line-height: 1;
}

.temperature-readout text:first-child { font-size: 112rpx; }
.temperature-readout .unit { margin-top: 18rpx; font-size: 40rpx; }

.wheel-wrap {
  position: relative;
  overflow: hidden;
  height: 260rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, var(--color-bg), var(--color-sky-soft), var(--color-bg));
}

.wheel-highlight {
  position: absolute;
  top: 90rpx;
  right: 24rpx;
  left: 24rpx;
  height: 80rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: 24rpx;
}

.temperature-wheel { position: relative; z-index: 1; width: 100%; height: 260rpx; }

.wheel-item {
  display: flex;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  color: var(--color-coral-deep);
  font-size: 38rpx;
  font-weight: 800;
}

.panel-note { display: block; margin-top: 20rpx; color: var(--color-faint); font-size: 24rpx; }

.form-card {
  margin-top: 30rpx;
  padding: 30rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: 38rpx;
  box-shadow: var(--shadow-soft);
}

.picker-value {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  color: var(--color-muted);
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 24rpx;
}

.spaced { margin-top: 30rpx; }

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.option {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  min-height: 148rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  padding: 16rpx 8rpx;
  color: var(--color-muted);
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 24rpx;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: normal;
}

.option-icon { width: 44rpx; height: 44rpx; }

.option.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-coral), #ff7048);
  border-color: transparent;
  box-shadow: 0 16rpx 32rpx rgba(255, 112, 72, 0.22);
}

.footer-actions {
  display: flex;
  gap: 18rpx;
  margin-top: auto;
  padding-top: 40rpx;
}

.half { width: 220rpx; margin: 0; }
.grow { flex: 1; margin: 0; }

.skip {
  min-height: 76rpx;
  margin-top: 14rpx;
  color: var(--color-muted);
  background: transparent;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
}

button::after { border: 0; }
