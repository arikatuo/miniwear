<view class="page onboarding">
  <view class="progress">
    <view wx:for="{{progressSteps}}" wx:key="*this" class="progress-item {{step >= item ? 'active' : ''}}"></view>
  </view>
  <text class="step-label">第 {{step + 1}} 步，共 3 步</text>

  <block wx:if="{{step === 0}}">
    <text class="page-title">今天从哪里出发？</text>
    <text class="page-subtitle">城市只用来获取天气。我们不会持续追踪位置。</text>
    <view class="illustration city-art">
      <view class="building one"></view><view class="building two"></view><view class="building three"></view>
    </view>
    <button class="primary-button" bindtap="chooseCity">{{city ? '已选择：' + city.name : '定位或手动选择城市'}}</button>
    <text class="help-text center">点击后才会申请定位权限；拒绝也不影响手动选择。</text>
  </block>

  <block wx:elif="{{step === 1}}">
    <text class="page-title">家里大约多少度？</text>
    <text class="page-subtitle">室温会用于在家和睡觉建议，不确定时用 24℃ 即可。</text>
    <view class="temperature">{{indoorTemp}}<text>℃</text></view>
    <view class="temperature-grid">
      <button wx:for="{{temperatureChoices}}" wx:key="*this" class="temp-choice {{indoorTemp == item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectTemperature">{{item}}℃</button>
    </view>
    <view class="manual-field">
      <text>手动输入</text>
      <input type="number" value="{{indoorTemp}}" bindinput="inputTemperature" aria-label="室内温度" />
      <text>℃</text>
    </view>
  </block>

  <block wx:else>
    <text class="page-title">再了解一点宝宝</text>
    <text class="page-subtitle">这些信息只保存在当前小程序本地，也可以先跳过。</text>
    <view class="form-card">
      <text class="form-label">出生日期</text>
      <picker mode="date" value="{{birthday}}" end="{{maxDate}}" bindchange="selectBirthday">
        <view class="picker-value">{{birthday || '未设置，默认按 6 个月处理'}}<text>›</text></view>
      </picker>
      <text class="form-label spaced">宝宝体质</text>
      <view class="option-grid">
        <button wx:for="{{bodyTypes}}" wx:key="value" class="option {{bodyType === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectBodyType">{{item.label}}</button>
      </view>
      <text class="form-label spaced">是否容易出汗</text>
      <view class="option-grid">
        <button wx:for="{{sweatTypes}}" wx:key="value" class="option {{easySweat === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectSweat">{{item.label}}</button>
      </view>
    </view>
  </block>

  <view class="footer-actions">
    <button wx:if="{{step > 0}}" class="ghost-button half" bindtap="previous">上一步</button>
    <button class="primary-button grow" bindtap="next">{{step === 2 ? '完成设置' : '下一步'}}</button>
  </view>
  <button class="skip" bindtap="skip">{{step === 2 ? '暂时跳过并开始使用' : '暂时跳过'}}</button>
</view>
