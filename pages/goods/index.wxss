.goods-page { padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }

.goods-hero { margin-bottom: 22rpx; }

.notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 0 26rpx;
  padding: 20rpx 22rpx;
  color: var(--color-butter-deep);
  background: linear-gradient(135deg, var(--color-butter-soft), #fff7df);
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-icon { width: 36rpx; height: 36rpx; flex: none; }

.category-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 10rpx;
  background: var(--color-bg-deep);
  border-radius: 32rpx;
}

.category-tabs button {
  display: flex;
  min-height: 124rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 0;
  color: var(--color-muted);
  background: transparent;
  border-radius: 25rpx;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.2;
}

.tab-icon { width: 44rpx; height: 44rpx; }

.category-tabs button.active {
  color: var(--color-ink);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.tab-desc { margin-top: 2rpx; color: var(--color-faint); font-size: 21rpx; font-weight: 700; }

.sub-tabs { width: 100%; margin: 22rpx 0 18rpx; white-space: nowrap; }

.sub-tabs button {
  display: inline-flex;
  min-width: 132rpx;
  min-height: 70rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 14rpx 0 0;
  padding: 0 24rpx;
  color: var(--color-muted);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 66rpx;
}

.sub-tabs button.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-coral), #ff7048);
  border-color: transparent;
}

.count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.35);
  color: inherit;
  font-size: 20rpx;
  line-height: 34rpx;
}

.sub-tabs button:not(.active) .count {
  background: var(--color-bg-deep);
}

.grouped-list { padding-top: 4rpx; }

.goods-group {
  margin-bottom: 26rpx;
  padding: 24rpx 0 26rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.group-head { display: flex; align-items: center; justify-content: space-between; padding: 0 24rpx 18rpx; }
.group-title { display: block; color: var(--color-ink); font-size: 32rpx; font-weight: 750; }
.group-subtitle { display: block; margin-top: 4rpx; color: var(--color-faint); font-size: 22rpx; }

.group-action {
  min-height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  color: var(--color-coral-deep);
  background: var(--color-coral-soft);
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 760;
  line-height: 58rpx;
}

.mini-row { width: 100%; white-space: nowrap; }

.mini-card {
  display: inline-flex;
  width: 206rpx;
  min-height: 276rpx;
  flex-direction: column;
  margin-left: 22rpx;
  padding: 16rpx;
  vertical-align: top;
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 26rpx;
}

.mini-card:last-child { margin-right: 22rpx; }
.mini-image { width: 172rpx; height: 148rpx; border-radius: 20rpx; background: var(--color-bg-deep); }
.mini-name { display: block; margin-top: 14rpx; color: var(--color-ink); font-size: 25rpx; font-weight: 750; line-height: 1.3; white-space: normal; }
.mini-warm { display: block; margin-top: 6rpx; color: var(--color-butter-deep); font-size: 21rpx; }

.goods-card {
  display: flex;
  gap: 22rpx;
  margin-bottom: 20rpx;
  padding: 22rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.goods-image { flex: none; width: 180rpx; height: 180rpx; background: var(--color-bg-deep); border-radius: 26rpx; }
.goods-content { flex: 1; min-width: 0; padding-top: 4rpx; }
.goods-name { display: block; color: var(--color-ink); font-size: 32rpx; font-weight: 750; line-height: 1.25; }
.meta-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 14rpx 0 10rpx; }
.warm, .range { padding: 6rpx 14rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 700; }
.warm { color: var(--color-butter-deep); background: var(--color-butter-soft); }
.range { color: var(--color-coral-deep); background: var(--color-coral-soft); }
.scenes, .description { display: block; color: var(--color-muted); font-size: 24rpx; line-height: 1.55; }
.description { margin-top: 8rpx; }

button::after { border: 0; }
