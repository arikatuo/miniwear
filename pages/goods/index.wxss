.goods-page {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.goods-hero {
  margin-bottom: 24rpx;
}

.notice {
  margin: 24rpx 0 28rpx;
  padding: 22rpx 24rpx;
  color: #735d35;
  background: linear-gradient(135deg, #fff7df, #fff1cf);
  border: 1rpx solid rgba(217, 163, 95, 0.15);
  border-radius: 26rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.category-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 10rpx;
  background: rgba(223, 233, 236, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.category-tabs button {
  display: flex;
  min-height: 112rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  color: var(--color-muted);
  background: transparent;
  border-radius: 25rpx;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
}

.category-tabs button.active {
  color: var(--color-text);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-soft);
}

.tab-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--color-faint);
  font-size: 21rpx;
  font-weight: 700;
}

.sub-tabs {
  width: 100%;
  margin: 24rpx 0 18rpx;
  white-space: nowrap;
}

.sub-tabs button {
  display: inline-flex;
  min-width: 132rpx;
  min-height: 70rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 14rpx 0 0;
  padding: 0 24rpx;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 70rpx;
}

.sub-tabs button.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-primary), #4d91ba);
  border-color: transparent;
  box-shadow: 0 14rpx 30rpx rgba(47, 111, 159, 0.18);
}

.count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(47, 111, 159, 0.08);
  color: inherit;
  font-size: 20rpx;
  line-height: 34rpx;
}

.grouped-list {
  padding-top: 4rpx;
}

.goods-group {
  margin-bottom: 28rpx;
  padding: 24rpx 0 26rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 34rpx;
  box-shadow: var(--shadow-soft);
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 18rpx;
}

.group-title {
  display: block;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 850;
}

.group-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--color-faint);
  font-size: 22rpx;
}

.group-action {
  min-height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 760;
  line-height: 58rpx;
}

.mini-row {
  width: 100%;
  white-space: nowrap;
}

.mini-card {
  display: inline-flex;
  width: 210rpx;
  min-height: 278rpx;
  flex-direction: column;
  margin-left: 24rpx;
  padding: 18rpx;
  vertical-align: top;
  background: rgba(249, 251, 250, 0.95);
  border: 1rpx solid rgba(228, 236, 239, 0.8);
  border-radius: 28rpx;
}

.mini-card:last-child {
  margin-right: 24rpx;
}

.mini-image {
  width: 174rpx;
  height: 150rpx;
  border-radius: 22rpx;
  background: #f1f5f5;
}

.mini-name {
  display: block;
  margin-top: 14rpx;
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: normal;
}

.mini-warm {
  display: block;
  margin-top: 8rpx;
  color: #8a6531;
  font-size: 21rpx;
}

.goods-card {
  display: flex;
  gap: 24rpx;
  margin-bottom: 22rpx;
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 34rpx;
  box-shadow: var(--shadow-soft);
}

.goods-image {
  flex: none;
  width: 184rpx;
  height: 184rpx;
  background: #f1f5f5;
  border-radius: 28rpx;
}

.goods-content {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.goods-name {
  display: block;
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.25;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 14rpx 0 10rpx;
}

.warm, .range {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.warm {
  color: #8a6531;
  background: var(--color-accent-soft);
}

.range {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.scenes, .description {
  display: block;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.description {
  margin-top: 8rpx;
  color: #536673;
}
