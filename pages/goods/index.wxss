.goods-page { padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }

.goods-hero { margin-bottom: 22rpx; }

.notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 0 26rpx;
  padding: 20rpx 22rpx;
  color: var(--color-butter-deep);
  background: linear-gradient(135deg, var(--color-butter-soft), #fff7df);
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-icon { width: 36rpx; height: 36rpx; flex: none; }

.focus-panel {
  margin: 0 0 24rpx;
  padding: 24rpx 0 24rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.focus-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 24rpx;
}

.focus-eyebrow {
  display: block;
  margin-bottom: 4rpx;
  color: var(--color-coral-deep);
  font-size: 22rpx;
  font-weight: 750;
}

.focus-title {
  display: block;
  color: var(--color-ink);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.focus-count {
  flex: none;
  min-height: 44rpx;
  padding: 0 16rpx;
  color: var(--color-muted);
  background: var(--color-surface-soft);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.focus-desc {
  display: block;
  margin: 12rpx 24rpx 18rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.focus-row { width: 100%; white-space: nowrap; }

.focus-card {
  display: inline-flex;
  width: 188rpx;
  min-height: 254rpx;
  flex-direction: column;
  margin-left: 22rpx;
  padding: 14rpx;
  vertical-align: top;
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 24rpx;
}

.focus-card:last-child { margin-right: 22rpx; }
.focus-image { width: 158rpx; height: 134rpx; border-radius: 18rpx; background: var(--color-bg-deep); }
.focus-name { display: block; margin-top: 12rpx; color: var(--color-ink); font-size: 24rpx; font-weight: 750; line-height: 1.3; white-space: normal; }
.focus-warm { display: block; margin-top: 6rpx; color: var(--color-butter-deep); font-size: 20rpx; }

.category-tabs {
  display: flex;
  gap: 10rpx;
  padding: 10rpx;
  background: var(--color-bg-deep);
  border-radius: 32rpx;
}

.category-tabs button {
  display: flex;
  flex: 1 1 0;
  width: 0;
  min-height: 124rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 0;
  color: var(--color-muted);
  background: transparent;
  border-radius: 25rpx;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.2;
}

.tab-icon { width: 44rpx; height: 44rpx; }

.category-tabs button.active {
  color: var(--color-ink);
  background: var(--color-surface);
  box-shadow: var(--shadow-soft);
}

.tab-desc { margin-top: 2rpx; color: var(--color-faint); font-size: 21rpx; font-weight: 700; }

/* ---- 楼层锚点导航：唯一的二级分类入口 ---- */
.floor-nav { width: 100%; margin: 24rpx 0 6rpx; white-space: nowrap; }

.floor-nav .floor {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 64rpx;
  margin: 0 12rpx 0 0;
  padding: 0 22rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: 999rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  font-weight: 700;
}

.floor-nav .floor:last-child { margin-right: 4rpx; }

.floor-nav .floor.current {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-coral), #ff7048);
  border-color: transparent;
}

.floor-count {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-bg-deep);
  color: var(--color-faint);
  font-size: 19rpx;
  line-height: 32rpx;
  text-align: center;
}

.floor.current .floor-count { background: rgba(255, 255, 255, 0.32); color: #ffffff; }

.grouped-list { padding-top: 8rpx; }

.goods-group {
  margin-bottom: 22rpx;
  padding: 22rpx 0 24rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.group-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 0 24rpx 16rpx;
}

.group-title { color: var(--color-ink); font-size: 30rpx; font-weight: 750; }
.group-count { color: var(--color-faint); font-size: 22rpx; }

.mini-row { width: 100%; white-space: nowrap; }

.mini-card {
  display: inline-flex;
  width: 206rpx;
  min-height: 276rpx;
  flex-direction: column;
  margin-left: 22rpx;
  padding: 16rpx;
  vertical-align: top;
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 26rpx;
}

.mini-card:last-child { margin-right: 22rpx; }
.mini-image { width: 172rpx; height: 148rpx; border-radius: 20rpx; background: var(--color-bg-deep); }
.mini-name { display: block; margin-top: 14rpx; color: var(--color-ink); font-size: 25rpx; font-weight: 750; line-height: 1.3; white-space: normal; }
.mini-warm { display: block; margin-top: 6rpx; color: var(--color-butter-deep); font-size: 21rpx; }

button::after { border: 0; }
