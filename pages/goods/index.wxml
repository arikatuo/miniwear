<view class="page goods-page">
  <view class="goods-hero">
    <text class="eyebrow">用品图鉴</text>
    <text class="page-title">宝宝用品</text>
    <text class="page-subtitle">穿衣和睡觉用品参考清单，不代表必须全部准备，请按家里实际情况选择。</text>
  </view>
  <view class="notice">
    <image class="notice-icon" src="/assets/icons/icon-thermometer.svg" mode="aspectFit" />
    <text>保暖值仅供参考，重点观察后颈温度、出汗和精神状态。</text>
  </view>
  <view class="category-tabs">
    <button class="{{category === 'clothing' ? 'active' : ''}}" data-value="clothing" bindtap="chooseCategory">
      <image class="tab-icon" src="/assets/icons/icon-hanger.svg" mode="aspectFit" />
      <text>穿衣用品</text>
      <text class="tab-desc">分层搭配</text>
    </button>
    <button class="{{category === 'sleep' ? 'active' : ''}}" data-value="sleep" bindtap="chooseCategory">
      <image class="tab-icon" src="/assets/icons/scene-sleep.svg" mode="aspectFit" />
      <text>睡觉用品</text>
      <text class="tab-desc">夜间保暖</text>
    </button>
  </view>
  <scroll-view class="sub-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <button wx:for="{{subCategories}}" wx:key="key" class="{{subCategory === item.key ? 'active' : ''}}" data-value="{{item.key}}" bindtap="chooseSubCategory">
      <text>{{item.label}}</text>
      <text class="count">{{item.count}}</text>
    </button>
  </scroll-view>

  <view wx:if="{{subCategory === 'all'}}" class="grouped-list">
    <view wx:for="{{groupedGoods}}" wx:key="key" class="goods-group">
      <view class="group-head">
        <view>
          <text class="group-title">{{item.label}}</text>
          <text class="group-subtitle">{{item.count}} 件参考用品</text>
        </view>
        <button class="group-action" data-value="{{item.key}}" bindtap="chooseSubCategory">查看全部</button>
      </view>
      <scroll-view class="mini-row" scroll-x enhanced show-scrollbar="{{false}}">
        <view wx:for="{{item.goods}}" wx:for-item="goodsItem" wx:key="id" class="mini-card">
          <image class="mini-image" src="{{goodsItem.illustration}}" mode="aspectFit" aria-label="{{goodsItem.name}}插画" />
          <text class="mini-name">{{goodsItem.name}}</text>
          <text class="mini-warm">{{goodsItem.warmText}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:elif="{{visibleGoods.length}}" class="goods-list">
    <view wx:for="{{visibleGoods}}" wx:key="id" class="goods-card">
      <image class="goods-image" src="{{item.illustration}}" mode="aspectFit" data-index="{{index}}" binderror="imageError" aria-label="{{item.name}}插画" />
      <view class="goods-content">
        <text class="goods-name">{{item.name}}</text>
        <view class="meta-row">
          <text class="warm">{{item.warmText}}</text>
          <text class="range">{{item.tempRange}}</text>
        </view>
        <text class="scenes">适用：{{item.sceneText}}</text>
        <text class="description">{{item.desc}}</text>
      </view>
    </view>
  </view>
  <empty-state wx:else title="当前分类暂无用品" description="换一个分类看看吧。" />
</view>
