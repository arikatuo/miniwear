.today-page { padding-top: 6rpx; }

.greeting {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  color: var(--color-muted);
  font-size: 25rpx;
}

.greeting-icon { width: 48rpx; height: 48rpx; }

.scene-switcher {
  display: flex;
  gap: 10rpx;
  margin: 24rpx 0;
  padding: 8rpx;
  background: var(--color-bg-deep);
  border-radius: 28rpx;
}

.scene-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0;
  border-radius: 20rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 700;
}

.scene-tab-icon { width: 40rpx; height: 40rpx; }

.scene-tab.active { background: var(--color-surface); box-shadow: var(--shadow-soft); }
.scene-tab.active.scene-indoor { color: var(--color-coral-deep); }
.scene-tab.active.scene-outdoor { color: var(--color-sky-deep); }
.scene-tab.active.scene-sleep { color: var(--color-lavender-deep); }

.share-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 92rpx;
  margin-top: 4rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-coral), #ff7048);
  border-radius: 26rpx;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 38rpx rgba(255, 112, 72, 0.26);
}

.share-icon { width: 32rpx; height: 32rpx; }

.global-tip {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: var(--color-butter-soft);
  border-radius: 26rpx;
  color: var(--color-butter-deep);
  font-size: 23rpx;
  line-height: 1.65;
}

.global-tip-icon { width: 34rpx; height: 34rpx; flex: none; margin-top: 2rpx; }

.switcher-skeleton { height: 96rpx; margin-top: 24rpx; }
.card-skeleton { height: 420rpx; margin-top: 22rpx; }
button::after { border: 0; }
