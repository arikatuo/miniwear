page {
  --color-primary: #2f6f9f;
  --color-primary-deep: #214f72;
  --color-primary-soft: #e7f2f7;
  --color-accent: #d9a35f;
  --color-accent-soft: #fff3dd;
  --color-background: #f5f8f6;
  --color-surface: #ffffff;
  --color-surface-soft: #f9fbfa;
  --color-text: #21313d;
  --color-muted: #6b7a86;
  --color-faint: #9aa8b2;
  --color-border: #e4ecef;
  --color-danger: #b85b5b;
  --shadow-soft: 0 18rpx 50rpx rgba(46, 94, 122, 0.08);
  --shadow-lift: 0 28rpx 70rpx rgba(43, 91, 119, 0.13);
  --radius-card: 34rpx;
  --radius-control: 24rpx;
  background:
    radial-gradient(circle at 18% 0%, rgba(255, 230, 188, 0.72), transparent 32%),
    radial-gradient(circle at 88% 12%, rgba(209, 230, 239, 0.85), transparent 34%),
    var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  font-size: 30rpx;
  line-height: 1.62;
}

view, text, button, input, picker, picker-view, picker-view-column, image, canvas {
  box-sizing: border-box;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 36rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.eyebrow {
  display: inline-flex;
  min-height: 44rpx;
  align-items: center;
  padding: 0 18rpx;
  border: 1rpx solid rgba(47, 111, 159, 0.12);
  border-radius: 999rpx;
  color: var(--color-primary);
  background: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.page-title {
  display: block;
  margin: 18rpx 0 12rpx;
  color: var(--color-text);
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.16;
}

.page-subtitle {
  display: block;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 1.68;
}

.section-title {
  display: block;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.25;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.74);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.primary-button,
.secondary-button,
.ghost-button {
  min-height: 96rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 96rpx;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-primary), #3f8bbb);
  box-shadow: 0 18rpx 42rpx rgba(47, 111, 159, 0.24);
}

.secondary-button {
  color: var(--color-primary-deep);
  background: var(--color-primary-soft);
}

.ghost-button {
  color: var(--color-text);
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid var(--color-border);
}

button {
  transition: transform 180ms ease, opacity 180ms ease, box-shadow 180ms ease;
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.86;
  transform: scale(0.985);
}

button[disabled] {
  opacity: 0.45;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 760;
}

.field {
  width: 100%;
  min-height: 92rpx;
  padding: 0 24rpx;
  color: var(--color-text);
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid var(--color-border);
  border-radius: 24rpx;
}

.help-text,
.disclaimer {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.disclaimer {
  margin-top: 32rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-size: 26rpx;
}

.skeleton {
  overflow: hidden;
  min-height: 100rpx;
  background: linear-gradient(90deg, #edf3f1 25%, #f8fbfa 50%, #edf3f1 75%);
  background-size: 200% 100%;
  border-radius: 20rpx;
  animation: shimmer 1.4s ease-in-out infinite;
}

@keyframes shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}
