page {
  --color-primary: #3478b9;
  --color-primary-soft: #e9f3fc;
  --color-background: #f7fbff;
  --color-surface: #ffffff;
  --color-text: #253342;
  --color-muted: #667789;
  --color-border: #dce8f2;
  --color-warm: #fff6dc;
  --color-success: #e7f6ed;
  --color-warning: #fff0e5;
  background: var(--color-background);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

view, text, button, input, picker, image, canvas {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page-title {
  margin: 8rpx 0 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  color: var(--color-muted);
  font-size: 28rpx;
}

.section-title {
  margin: 40rpx 0 20rpx;
  font-size: 34rpx;
  font-weight: 650;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border: 1rpx solid rgba(52, 120, 185, 0.08);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(50, 92, 126, 0.07);
}

.primary-button,
.secondary-button,
.ghost-button {
  min-height: 88rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button {
  color: #ffffff;
  background: var(--color-primary);
}

.secondary-button {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.ghost-button {
  color: var(--color-text);
  background: #ffffff;
  border: 1rpx solid var(--color-border);
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.8;
  transform: scale(0.985);
}

button[disabled] {
  opacity: 0.45;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.field {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  color: var(--color-text);
  background: #ffffff;
  border: 1rpx solid var(--color-border);
  border-radius: 20rpx;
}

.help-text,
.disclaimer {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.disclaimer {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f2f6f9;
  border-radius: 20rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-size: 26rpx;
}

.skeleton {
  overflow: hidden;
  min-height: 100rpx;
  background: linear-gradient(90deg, #edf3f7 25%, #f8fbfd 50%, #edf3f7 75%);
  background-size: 200% 100%;
  border-radius: 20rpx;
  animation: shimmer 1.4s ease-in-out infinite;
}

@keyframes shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}
