.weather-shell { }

.combo-card {
  display: flex;
  align-items: stretch;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.combo-half {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
  padding: 22rpx 20rpx;
}

.weather-half { flex: 1.06 1 0; }
.temp-half { flex: 0.94 1 0; }

.combo-divider {
  width: 1.5rpx;
  margin: 18rpx 0;
  background: var(--color-border);
}

.combo-icon-wrap {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  background: var(--color-sky-soft);
  border-radius: 20rpx;
}

.combo-icon-wrap.warm { background: var(--color-butter-soft); }
.combo-icon-wrap.muted { background: var(--color-bg-deep); }
.combo-icon { width: 44rpx; height: 44rpx; }

.combo-body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.combo-topline {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
}

.combo-label {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: var(--color-faint);
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.combo-mainline {
  display: flex;
  align-items: baseline;
  min-height: 40rpx;
  margin-top: 4rpx;
}

.combo-value { display: block; color: var(--color-ink); font-size: 33rpx; font-weight: 750; line-height: 1.12; }
.combo-value.small { color: var(--color-coral-deep); font-size: 25rpx; }
.combo-range { display: block; margin-top: 4rpx; color: var(--color-faint); font-size: 21rpx; font-weight: 600; line-height: 1.2; }
.combo-action { flex: none; color: var(--color-coral-deep); font-size: 22rpx; font-weight: 700; white-space: nowrap; }
.city-action { font-size: 21rpx; }

.spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--color-sky-soft);
  border-top-color: var(--color-sky);
  border-radius: 50%;
  animation: spin 800ms linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.combo-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
  margin-top: 8rpx;
  padding: 0 6rpx;
}

.stale {
  flex: 1;
  overflow: hidden;
  color: var(--color-butter-deep);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footer-links { display: flex; flex: none; gap: 18rpx; }

.link-button {
  min-height: 56rpx;
  margin: 0;
  padding: 0;
  color: var(--color-sky-deep);
  background: transparent;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 56rpx;
}

button::after { border: 0; }
