<view wx:if="{{item}}" class="recommend-card scene-{{item.scene}}">
  <view class="card-label">
    <image class="card-label-icon" src="{{sceneIcon}}" mode="aspectFit" />
    <text>今天{{sceneLabel}}建议</text>
  </view>
  <text class="result">{{item.result}}</text>
  <text class="reason">{{item.reason}}</text>
  <text wx:if="{{adjustmentLabel && !adopted}}" class="adjustment-note">{{adjustmentLabel}}</text>
  <button class="adopt-button {{adopted ? 'adopted' : ''}}" disabled="{{adopted}}" bindtap="confirm">{{adopted ? '已记下今天穿法' : '记下今天穿法'}}</button>
  <button class="adjust-button" bindtap="openAdjust">调整搭配</button>
  <view class="goods-link" bindtap="viewGoods" role="button" aria-label="查看衣物图例与替代项">查看衣物图例 ›</view>
</view>
