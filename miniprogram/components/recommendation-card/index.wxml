<view wx:if="{{item}}" class="recommend-card scene-{{item.scene}}">
  <view class="card-hero">
    <view class="card-label">
      <image class="card-label-icon" src="{{sceneIcon}}" mode="aspectFit" />
      <text>今天{{sceneLabel}}建议</text>
    </view>
    <text class="result" style="{{resultLong ? 'font-size: 42rpx; line-height: 1.34;' : ''}}">{{item.result}}</text>
    <text class="reason">{{item.reason}}</text>
    <view class="level-meter" aria-label="厚薄程度：{{levelText}}">
      <text class="level-name">厚薄</text>
      <view class="dots">
        <view wx:for="{{dots}}" wx:for-item="dot" wx:key="n" class="dot {{dot.on ? 'on' : ''}}"></view>
      </view>
      <text class="level-text">{{levelText}}</text>
    </view>
  </view>

  <view class="card-body">
    <view wx:if="{{pieces.length}}" class="pieces">
      <view wx:for="{{pieces}}" wx:for-item="piece" wx:key="id" class="piece" bindtap="viewGoods" role="button" aria-label="{{piece.name}}">
        <image class="piece-image" src="{{piece.illustration}}" mode="aspectFit" />
        <text class="piece-name">{{piece.name}}</text>
      </view>
    </view>
    <view class="goods-link" bindtap="viewGoods" role="button" aria-label="查看衣物图例与替代项">看衣物图例与替代项 ›</view>

    <text wx:if="{{adjustmentLabel && !adopted}}" class="adjustment-note">{{adjustmentLabel}}</text>
    <button class="adopt-button {{adopted ? 'adopted' : ''}}" disabled="{{adopted}}" bindtap="confirm">
      <image wx:if="{{adopted}}" class="adopt-icon" src="/assets/icons/icon-check.svg" mode="aspectFit" />
      <text>{{adopted ? '已记下今天穿法' : '记下今天穿法'}}</text>
    </button>
    <button class="adjust-button" bindtap="openAdjust">觉得偏冷或偏热？调整厚薄</button>
  </view>
</view>
