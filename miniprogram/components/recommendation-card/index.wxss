.recommend-card {
  padding: 34rpx 30rpx 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.card-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  color: var(--scene-deep);
  background: var(--scene-soft);
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.card-label-icon { width: 28rpx; height: 28rpx; }

.result {
  display: block;
  margin-top: 26rpx;
  color: var(--color-ink);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.32;
}

.reason {
  display: block;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.adjustment-note {
  display: block;
  margin-top: 14rpx;
  color: var(--color-butter-deep);
  font-size: 23rpx;
}

.adopt-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 94rpx;
  margin: 42rpx 0 0;
  color: #fff;
  background: var(--color-coral);
  border-radius: 24rpx;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(255, 138, 101, .22);
}

.adopt-button.adopted {
  color: var(--color-mint-deep);
  background: var(--color-mint-soft);
  box-shadow: none;
}

.adjust-button {
  min-height: 82rpx;
  margin: 16rpx 0 0;
  color: var(--color-coral-deep);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-coral);
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 82rpx;
}

.goods-link {
  margin-top: 20rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

button::after { border: 0; }
