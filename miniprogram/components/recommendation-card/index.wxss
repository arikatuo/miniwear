@import "../../styles/shared.wxss";

.recommend-card {
  overflow: hidden;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lift);
  animation: rise-in 360ms ease both;
}

/* 顶部"答案区"：场景色渐变，一眼看到结论 */
.card-hero { padding: 32rpx 32rpx 28rpx; background: var(--scene-grad); }

.card-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
  padding: 0 18rpx 0 12rpx;
  color: var(--scene-ink);
  background: rgba(255, 255, 255, 0.78);
  border-radius: var(--radius-chip);
  font-size: 24rpx;
  font-weight: 700;
}

.card-label-icon { width: 30rpx; height: 30rpx; }

.result {
  display: block;
  margin-top: 26rpx;
  color: var(--color-ink);
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: -0.01em;
}

.reason { display: block; margin-top: 14rpx; color: var(--color-muted); font-size: 26rpx; line-height: 1.6; }

.level-meter { display: flex; align-items: center; gap: 14rpx; margin-top: 24rpx; }
.level-name { color: var(--color-muted); font-size: 23rpx; font-weight: 700; }
.dots { display: flex; gap: 8rpx; }
.dot { width: 34rpx; height: 12rpx; background: rgba(62, 49, 40, 0.12); border-radius: 99rpx; }
.dot.on { background: var(--scene-color); }
.level-text { color: var(--scene-ink); font-size: 24rpx; font-weight: 750; }

.card-body { padding: 26rpx 28rpx 28rpx; }

.pieces { display: flex; justify-content: center; gap: 14rpx; }
.piece { flex: 1 1 0; max-width: 214rpx; min-width: 0; padding: 12rpx 8rpx 10rpx; background: var(--scene-tint); border-radius: 26rpx; text-align: center; }
.piece-image { display: block; width: 100%; height: 132rpx; border-radius: 18rpx; }
.piece-name { display: block; margin-top: 8rpx; overflow: hidden; color: var(--color-ink); font-size: 23rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }

.goods-link { margin: 14rpx 0 6rpx; padding: 10rpx 0; color: var(--scene-ink); font-size: 25rpx; font-weight: 650; text-align: center; }

.adjustment-note { display: block; margin: 6rpx 0 14rpx; color: var(--color-butter-ink); font-size: 24rpx; font-weight: 600; text-align: center; }

.adopt-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100% !important;
  min-height: 100rpx;
  margin-top: 12rpx;
  margin-bottom: 0;
  padding: 0 24rpx !important;
  color: #ffffff;
  background: linear-gradient(135deg, #F47A52 0%, #E5593A 100%);
  border-radius: 32rpx;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.2;
  box-shadow: 0 16rpx 34rpx rgba(229, 89, 58, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
}

.adopt-button.adopted,
.adopt-button.adopted[disabled] {
  color: var(--color-mint-ink);
  background: var(--color-mint-soft);
  box-shadow: none;
  opacity: 1;
}

.adopt-icon { width: 38rpx; height: 38rpx; animation: pop-in 420ms ease both; }

.adjust-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: 84rpx;
  margin-top: 14rpx;
  margin-bottom: 0;
  padding: 0 24rpx !important;
  color: var(--color-muted);
  background: transparent;
  border: 1.5rpx solid var(--color-border-strong);
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.2;
}
