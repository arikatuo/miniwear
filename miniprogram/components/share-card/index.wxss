@import "../../styles/shared.wxss";

.overlay { z-index: 110; backdrop-filter: blur(8rpx); }
.panel { display: flex; max-height: 94vh; flex-direction: column; background: linear-gradient(180deg, #fffdf9, var(--color-bg)); }
.panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.head-text { min-width: 0; }
.title { display: block; color: var(--color-ink); font-size: 36rpx; font-weight: 800; line-height: 1.25; }
.subtitle { display: block; margin-top: 6rpx; color: var(--color-muted); font-size: 25rpx; }
.close { flex: none; width: 72rpx; min-height: 72rpx; margin: 0; padding: 0; color: var(--color-muted); background: var(--color-surface); border: 1.5rpx solid var(--color-border); border-radius: 50%; font-size: 40rpx; font-weight: 400; line-height: 66rpx; }

.preview { display: flex; height: 680rpx; max-height: 54vh; flex: none; align-items: center; justify-content: center; margin-top: 24rpx; background: linear-gradient(180deg, var(--color-coral-soft), var(--color-bg)); border: 1.5rpx solid var(--color-border); border-radius: 34rpx; text-align: center; box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.7); }
.image { width: 100%; height: 100%; border-radius: 28rpx; animation: fade-in 260ms ease both; }
.loading { display: flex; height: 100%; align-items: center; justify-content: center; color: var(--color-muted); font-size: 26rpx; }
.loading-card { display: flex; width: 360rpx; min-height: 180rpx; flex-direction: column; align-items: center; justify-content: center; gap: 22rpx; background: rgba(255, 255, 255, 0.78); border: 1.5rpx solid var(--color-border); border-radius: 30rpx; box-shadow: var(--shadow-soft); }
.loading-icon { width: 54rpx; height: 54rpx; border: 6rpx solid var(--color-coral-soft); border-top-color: var(--color-coral); border-radius: 50%; animation: spin 820ms linear infinite; }

.canvas { position: fixed; left: -9999px; width: 600px; height: 900px; }

.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.save { flex: 1.5 1 0; min-width: 0; }
.send { flex: 1 1 0; min-width: 0; }
.note { display: block; margin-top: 16rpx; color: var(--color-muted); font-size: 23rpx; text-align: center; }
