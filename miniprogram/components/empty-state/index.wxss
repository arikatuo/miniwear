@import "../../styles/shared.wxss";

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 8rpx 0 22rpx;
  padding: 44rpx 36rpx 40rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  text-align: center;
  animation: rise-in 360ms ease both;
}

.mascot-wrap { animation: float-y 3.6s ease-in-out infinite; }
.mascot { width: 280rpx; height: 198rpx; }
.title, .description { display: block; }
.title { margin-top: 10rpx; color: var(--color-ink); font-size: 34rpx; font-weight: 800; }
.description { margin-top: 10rpx; color: var(--color-muted); font-size: 26rpx; line-height: 1.65; }
.action { margin-top: 32rpx; }
