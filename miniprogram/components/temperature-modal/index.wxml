<view wx:if="{{visible}}" class="sheet-mask" bindtap="close">
  <view class="sheet" catchtap="stop">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <view class="head-icon-wrap"><image class="head-icon" src="/assets/icons/icon-thermometer.svg" mode="aspectFit" /></view>
      <view class="head-text">
        <text class="title">家里现在多少度？</text>
        <text class="copy">看一眼温度计就好；不确定就先用 24℃。</text>
      </view>
    </view>
    <view class="stepper">
      <view class="step-button" data-delta="-1" bindtap="step" hover-class="pressed" role="button" aria-label="降低 1 度">−</view>
      <view class="readout">
        <input class="readout-input num" type="digit" value="{{draft}}" bindinput="input" maxlength="4" aria-label="室内温度" />
        <text class="readout-unit">℃</text>
      </view>
      <view class="step-button" data-delta="1" bindtap="step" hover-class="pressed" role="button" aria-label="升高 1 度">+</view>
    </view>
    <view class="choices">
      <button wx:for="{{choices}}" wx:key="*this" class="choice {{draft == item ? 'active' : ''}}" data-value="{{item}}" bindtap="choose">{{item}}℃</button>
    </view>
    <button class="primary-button confirm" bindtap="confirm">保存室温</button>
    <button class="text-button cancel" bindtap="close">取消</button>
  </view>
</view>
