page {
  /* ---- 品牌色板：奶油底 + 珊瑚橙主色，三场景三色编码 ---- */
  --color-bg: #FFF8EF;
  --color-bg-deep: #FFF1DC;
  --color-surface: #FFFFFF;
  --color-surface-soft: #FFFDFA;

  --color-coral: #FF8A65;
  --color-coral-deep: #E8643A;
  --color-coral-soft: #FFE0D1;

  --color-butter: #FFC85C;
  --color-butter-deep: #E29A2E;
  --color-butter-soft: #FFEFC2;

  --color-sky: #4FB8D6;
  --color-sky-deep: #3D9FC0;
  --color-sky-soft: #DFF4F8;

  --color-lavender: #8B8FE0;
  --color-lavender-deep: #6B6FC4;
  --color-lavender-soft: #ECECFB;

  --color-mint: #4FC392;
  --color-mint-deep: #3FAE82;
  --color-mint-soft: #DFF8EC;

  --color-ink: #4A3B30;
  --color-muted: #8A7868;
  --color-faint: #B7A99B;
  --color-border: #F3E4D5;
  --color-danger: #E2685A;
  --color-danger-soft: #FCE6E2;

  /* 三场景配色变量（默认在家=珊瑚橙），由 .scene-* 覆盖 */
  --scene-color: var(--color-coral);
  --scene-deep: var(--color-coral-deep);
  --scene-soft: var(--color-coral-soft);

  --shadow-soft: 0 14rpx 38rpx rgba(214, 142, 96, 0.14);
  --shadow-lift: 0 24rpx 56rpx rgba(214, 120, 80, 0.18);
  --radius-card: 36rpx;
  --radius-control: 26rpx;

  background: var(--color-bg);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

view, text, button, input, picker, picker-view, picker-view-column, image, canvas, scroll-view {
  box-sizing: border-box;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 30rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

/* ---- 场景色编码：在家 / 出门 / 睡觉 ---- */
.scene-indoor { --scene-color: var(--color-coral); --scene-deep: var(--color-coral-deep); --scene-soft: var(--color-coral-soft); }
.scene-outdoor { --scene-color: var(--color-sky); --scene-deep: var(--color-sky-deep); --scene-soft: var(--color-sky-soft); }
.scene-sleep { --scene-color: var(--color-lavender); --scene-deep: var(--color-lavender-deep); --scene-soft: var(--color-lavender-soft); }

/* ---- 文字层级 ---- */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--color-coral-soft);
  color: var(--color-coral-deep);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.page-title {
  display: block;
  margin: 16rpx 0 10rpx;
  color: var(--color-ink);
  font-size: 48rpx;
  font-weight: 750;
  line-height: 1.28;
}

.page-subtitle {
  display: block;
  color: var(--color-muted);
  font-size: 27rpx;
  line-height: 1.65;
}

.section-title {
  display: block;
  color: var(--color-ink);
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.3;
}

/* ---- 卡片 / 容器 ---- */
.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

/* ---- 按钮 ---- */
.primary-button,
.secondary-button,
.ghost-button {
  min-height: 96rpx;
  border-radius: 30rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.primary-button {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-coral), #ff7048);
  box-shadow: 0 18rpx 38rpx rgba(255, 112, 72, 0.28);
}

.secondary-button {
  color: var(--color-coral-deep);
  background: var(--color-coral-soft);
}

.ghost-button {
  color: var(--color-ink);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
}

button {
  transition: transform 180ms ease, opacity 180ms ease, box-shadow 180ms ease;
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.86;
  transform: scale(0.98);
}

button[disabled] {
  opacity: 0.45;
}

/* ---- 表单 ---- */
.form-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--color-ink);
  font-size: 27rpx;
  font-weight: 700;
}

.field {
  width: 100%;
  min-height: 92rpx;
  padding: 0 24rpx;
  color: var(--color-ink);
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 24rpx;
}

.help-text,
.disclaimer {
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.disclaimer {
  margin-top: 30rpx;
  padding: 22rpx 24rpx;
  background: var(--color-butter-soft);
  border-radius: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: var(--scene-deep);
  background: var(--scene-soft);
  font-size: 25rpx;
  font-weight: 700;
}

.icon-img {
  flex: none;
  display: block;
}

.skeleton {
  overflow: hidden;
  min-height: 100rpx;
  background: linear-gradient(90deg, #fbeee0 25%, #fff8ef 50%, #fbeee0 75%);
  background-size: 200% 100%;
  border-radius: 24rpx;
  animation: shimmer 1.4s ease-in-out infinite;
}

@keyframes shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}
