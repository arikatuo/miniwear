.settings-page { padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }
.settings-hero { margin-bottom: 30rpx; }

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 34rpx 0 16rpx;
}

.section-note { color: var(--color-faint); font-size: 23rpx; font-weight: 700; }

.settings-card {
  overflow: hidden;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.setting-row {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  gap: 18rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid var(--color-border);
  color: var(--color-ink);
  font-size: 29rpx;
  font-weight: 700;
}

.setting-row:last-child { border-bottom: 0; }

.row-icon-wrap {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  background: var(--color-coral-soft);
  border-radius: 18rpx;
}

.row-icon-wrap.danger { background: var(--color-danger-soft); }
.row-icon { width: 38rpx; height: 38rpx; }

.row-label { flex: 1; }

.setting-row.static { color: var(--color-muted); font-weight: 650; }
.temp-row { border-bottom: 0; }

.value { max-width: 50%; color: var(--color-muted); font-weight: 650; text-align: right; }
.value.strong { color: var(--color-coral-deep); font-size: 34rpx; font-weight: 850; }

.danger .row-label, .danger .value { color: var(--color-danger); }

.settings-temp-wheel {
  position: relative;
  height: 214rpx;
  margin: 0 24rpx 24rpx;
  overflow: hidden;
  background: linear-gradient(180deg, var(--color-bg), var(--color-sky-soft), var(--color-bg));
  border-radius: 28rpx;
}

.wheel-highlight {
  position: absolute;
  top: 71rpx;
  right: 22rpx;
  left: 22rpx;
  height: 72rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: 22rpx;
}

.temperature-wheel { position: relative; z-index: 1; width: 100%; height: 214rpx; }
.wheel-item { display: flex; height: 72rpx; align-items: center; justify-content: center; color: var(--color-coral-deep); font-size: 36rpx; font-weight: 850; }

.disclaimer { margin-bottom: 10rpx; }
