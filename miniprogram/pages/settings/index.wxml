<view class="page settings-page" wx:if="{{profile}}">
  <view class="settings-hero">
    <text class="eyebrow">个人化建议</text>
    <text class="page-title">宝宝设置</text>
    <text class="page-subtitle">这些信息只保存在本地，用来让穿衣建议更贴近宝宝状态。</text>
  </view>

  <view class="section-heading">
    <text class="section-title">宝宝信息</text>
    <text class="section-note">基础资料</text>
  </view>
  <view class="settings-card">
    <picker mode="date" value="{{profile.birthday}}" end="{{maxDate}}" bindchange="birthdayChange">
      <view class="setting-row">
        <view class="row-icon-wrap"><image class="row-icon" src="/assets/icons/icon-babybib.svg" mode="aspectFit" /></view>
        <text class="row-label">出生日期</text>
        <text class="value">{{profile.birthday || '未设置'}} ›</text>
      </view>
    </picker>
    <view class="setting-row static">
      <view class="row-icon-wrap"><image class="row-icon" src="/assets/icons/icon-heart.svg" mode="aspectFit" /></view>
      <text class="row-label">当前月龄</text>
      <text class="value">{{ageText}}</text>
    </view>
    <picker range="{{bodyOptions}}" range-key="label" value="{{bodyIndex}}" bindchange="bodyChange">
      <view class="setting-row">
        <view class="row-icon-wrap"><image class="row-icon" src="/assets/icons/weather-hot.svg" mode="aspectFit" /></view>
        <text class="row-label">宝宝体质</text>
        <text class="value">{{bodyOptions[bodyIndex].label}} ›</text>
      </view>
    </picker>
    <picker range="{{sweatOptions}}" range-key="label" value="{{sweatIndex}}" bindchange="sweatChange">
      <view class="setting-row">
        <view class="row-icon-wrap"><image class="row-icon" src="/assets/icons/weather-rain.svg" mode="aspectFit" /></view>
        <text class="row-label">出汗情况</text>
        <text class="value">{{sweatOptions[sweatIndex].label}} ›</text>
      </view>
    </picker>
  </view>

  <view class="section-heading">
    <text class="section-title">环境设置</text>
    <text class="section-note">默认参考</text>
  </view>
  <view class="settings-card">
    <view class="setting-row static temp-row">
      <view class="row-icon-wrap"><image class="row-icon" src="/assets/icons/icon-thermometer.svg" mode="aspectFit" /></view>
      <text class="row-label">默认室内温度</text>
      <text class="value strong">{{draftIndoorTemp}}℃</text>
    </view>
    <view class="settings-temp-wheel">
      <view class="wheel-highlight"></view>
      <picker-view class="temperature-wheel compact" value="{{tempPickerValue}}" bindchange="indoorChange" immediate-change="{{true}}" indicator-style="height: 72rpx;">
        <picker-view-column>
          <view wx:for="{{tempValues}}" wx:key="*this" class="wheel-item compact">{{item}}℃</view>
        </picker-view-column>
      </picker-view>
    </view>
    <view class="setting-row" bindtap="chooseCity" role="button">
      <view class="row-icon-wrap"><image class="row-icon" src="/assets/icons/icon-pin.svg" mode="aspectFit" /></view>
      <text class="row-label">所在城市</text>
      <text class="value">{{city ? city.name : '未设置'}} ›</text>
    </view>
  </view>

  <view class="section-heading">
    <text class="section-title">数据与隐私</text>
    <text class="section-note">本地存储</text>
  </view>
  <view class="settings-card">
    <view class="setting-row" bindtap="openPrivacy" role="button">
      <view class="row-icon-wrap"><image class="row-icon" src="/assets/icons/icon-shield.svg" mode="aspectFit" /></view>
      <text class="row-label">隐私说明</text>
      <text class="value">›</text>
    </view>
    <view class="setting-row danger" bindtap="clearData" role="button">
      <view class="row-icon-wrap danger"><image class="row-icon" src="/assets/icons/icon-trash.svg" mode="aspectFit" /></view>
      <text class="row-label">清除本地数据</text>
      <text class="value">›</text>
    </view>
  </view>
  <view class="disclaimer">使用提示：本建议仅供日常穿衣参考，不构成医疗建议。</view>
</view>
