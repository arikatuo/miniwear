.onboarding { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.hero-copy { margin: 16rpx 0 24rpx; }
.page-title { font-size: 42rpx; }
.page-subtitle { font-size: 26rpx; line-height: 1.6; }
.form-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid var(--color-border); border-radius: 26rpx; background: var(--color-surface); }
.form-label { display: block; font-size: 28rpx; font-weight: 700; margin-bottom: 18rpx; }
.option-grid,.age-grid { display: flex; gap: 12rpx; }
.option,.age-option { flex: 1; min-width: 0; padding: 16rpx 4rpx; font-size: 25rpx; line-height: 1.5; border-radius: 18rpx; color: var(--color-muted); background: var(--color-bg-deep); }
.option { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.option-icon { width: 42rpx; height: 42rpx; }
.active { color: var(--color-coral-deep); background: var(--color-coral-soft); }
.temperature-input { display: flex; align-items: center; gap: 16rpx; font-size: 32rpx; }
.temperature-input input { flex: 1; height: 76rpx; padding: 0 22rpx; border-radius: 16rpx; background: var(--color-bg-deep); }
.form-note { display: block; color: var(--color-muted); font-size: 23rpx; line-height: 1.55; margin-top: 14rpx; }
button::after { border: 0; }