<view class="page onboarding">
  <view class="hero-copy"><text class="eyebrow">宝宝今天穿什么</text><text class="page-title">先看看这一刻怎么穿</text><text class="page-subtitle">选场景、确认温度和年龄段，就能得到第一套参考。</text></view>
  <view class="form-card"><text class="form-label">现在要看哪个场景？</text><view class="option-grid"><button wx:for="{{scenes}}" wx:key="value" class="option {{selectedScene === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectScene"><image class="option-icon" src="{{item.icon}}" mode="aspectFit"/><text>{{item.label}}</text></button></view></view>
  <view class="form-card"><text class="form-label">{{selectedScene === 'outdoor' ? '室外现在多少度？' : '房间现在多少度？'}}</text>
    <view class="temperature-input"><input wx:if="{{selectedScene === 'outdoor'}}" type="text" value="{{draftOutdoorTemp}}" placeholder="例如 22" bindinput="inputOutdoor" aria-label="室外温度"/><input wx:else type="digit" value="{{draftIndoorTemp}}" bindinput="inputIndoor" aria-label="室内温度"/><text>℃</text></view>
    <text class="form-note">{{selectedScene === 'outdoor' ? '按你填写的室外温度生成，可稍后切换实时天气。' : '默认显示 24℃，请按温度计修改或确认。无需先选城市。'}}</text>
  </view>
  <view class="form-card"><text class="form-label">宝宝年龄段</text><view class="age-grid"><button wx:for="{{ageGroups}}" wx:key="value" class="age-option {{selectedAgeGroup === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectAgeGroup">{{item.label}}</button></view><text class="form-note">不需要填写生日，稍后可在设置中完善。</text></view>
  <button class="primary-button" bindtap="finish">查看{{selectedScene === 'indoor' ? '在家' : selectedScene === 'outdoor' ? '出门' : '睡觉'}}穿搭</button>
</view>