<view class="page city-page">
  <view class="location-card">
    <view class="location-icon-wrap"><image class="location-icon" src="/assets/icons/icon-pin.svg" mode="aspectFit" /></view>
    <view class="location-text">
      <text class="location-title">使用当前位置</text>
      <text class="location-copy">只在你点击后获取，用于查询城市天气。</text>
    </view>
    <button class="locate" bindtap="locate" loading="{{locating}}" disabled="{{locating}}">一键定位</button>
  </view>

  <view class="search">
    <text class="search-icon">⌕</text>
    <input value="{{keyword}}" bindinput="inputKeyword" placeholder="输入城市名称，如杭州" placeholder-class="search-placeholder" confirm-type="search" aria-label="搜索城市" />
  </view>

  <block wx:if="{{!keyword}}">
    <block wx:if="{{recentCities.length}}">
      <text class="section-title">最近使用</text>
      <view class="chip-wrap">
        <button wx:for="{{recentCities}}" wx:key="name" class="chip {{currentCity && currentCity.name === item.name ? 'current' : ''}}" data-city="{{item}}" bindtap="choose">{{item.name}}</button>
      </view>
    </block>
    <text class="section-title">热门城市</text>
    <view class="chip-wrap">
      <button wx:for="{{hotCities}}" wx:key="code" class="chip {{currentCity && currentCity.name === item.name ? 'current' : ''}}" data-city="{{item}}" bindtap="choose">{{item.name}}</button>
    </view>
  </block>

  <text class="section-title">{{keyword ? '搜索结果' : '全部城市'}}</text>
  <view wx:if="{{results.length}}" class="city-list">
    <view wx:for="{{results}}" wx:key="code" class="city-row {{currentCity && currentCity.name === item.name ? 'current' : ''}}" data-city="{{item}}" bindtap="choose" role="button" aria-label="选择{{item.name}}">
      <text class="city-name">{{item.name}}</text>
      <text wx:if="{{currentCity && currentCity.name === item.name}}" class="city-tag">当前</text>
      <text wx:else class="city-arrow">›</text>
    </view>
  </view>
  <empty-state
    wx:else
    title="常用城市列表里没有找到"
    description="可以直接使用“{{keyword}}”，有天气服务时会自动查询行政区划。"
    action-text="使用“{{keyword}}”"
    bind:action="chooseCustomCity"
  />
</view>
