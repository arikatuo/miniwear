.weather-form { margin-top: 30rpx; }

.temperature-input {
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 22rpx;
}

.temperature-input input { flex: 1; min-height: 92rpx; color: var(--color-ink); font-size: 42rpx; font-weight: 700; }
.spaced { margin-top: 28rpx; }

.weather-options { display: flex; gap: 14rpx; }

.weather-options button {
  display: flex;
  flex: 1 1 0;
  width: 0;
  min-height: 116rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin: 0;
  color: var(--color-muted);
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.weather-option-icon { width: 40rpx; height: 40rpx; }

.weather-options button.active {
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-coral), #ff7048);
  border-color: transparent;
}

.submit { margin-top: 28rpx; }
button::after { border: 0; }
