.weather-form { margin-top: 28rpx; }
.spaced { margin-top: 30rpx; }

.temp-field { display: flex; align-items: center; gap: 12rpx; padding: 10rpx; background: var(--color-surface-soft); border: 1.5rpx solid var(--color-border); border-radius: 30rpx; }
.step { display: flex; width: 92rpx; height: 92rpx; min-height: 92rpx; flex: none; align-items: center; justify-content: center; margin: 0; padding: 0; color: var(--color-coral-ink); background: var(--color-coral-soft); border-radius: 22rpx; font-size: 46rpx; font-weight: 500; line-height: 1; }
.temp-input { flex: 1; min-width: 0; height: 92rpx; color: var(--color-ink); font-size: 56rpx; font-weight: 800; line-height: 92rpx; text-align: right; }
.temp-unit { margin-right: 6rpx; color: var(--color-muted); font-size: 30rpx; font-weight: 700; }

.weather-options { display: flex; gap: 10rpx; }

.weather-options button {
  display: flex;
  flex: 1 1 0;
  width: 0;
  min-height: 124rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  padding: 0;
  color: var(--color-muted);
  background: var(--color-surface-soft);
  border: 1.5rpx solid var(--color-border);
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.weather-option-icon { width: 42rpx; height: 42rpx; }
.weather-options button.active { color: #ffffff; background: linear-gradient(135deg, #F47A52 0%, #E5593A 100%); border-color: transparent; box-shadow: 0 10rpx 22rpx rgba(229, 89, 58, 0.24); }

.submit { margin-top: 28rpx; }
