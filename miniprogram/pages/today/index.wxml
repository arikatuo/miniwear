<view class="page today-page">
  <block wx:if="{{sharedSnapshot}}">
    <view class="shared-card">
      <text class="eyebrow">家人转来的只读参考</text>
      <text class="shared-title">{{sharedSnapshot.scene === 'indoor' ? '在家' : sharedSnapshot.scene === 'outdoor' ? '出门' : '睡觉'}} · {{sharedSnapshot.date}}</text>
      <text>{{sharedSnapshot.scene === 'outdoor' ? '室外 ' + sharedSnapshot.outdoorTemp : '室温 ' + sharedSnapshot.indoorTemp}}℃ · {{sharedSnapshot.source === 'indoor' ? '室温填写' : sharedSnapshot.source === 'manual' ? '手动填写' : '自动天气'}}</text>
      <text class="shared-note">年龄段：{{sharedSnapshot.ageGroup === 'baby_0_6m' ? '0–6 个月' : sharedSnapshot.ageGroup === 'baby_6_12m' ? '6–12 个月' : '1–3 岁'}} · 请核对日期和当前温度</text><text class="shared-result">{{sharedSnapshot.result}}</text>
      <text class="shared-note">这是对方当时选定的参考，不会写入你的宝宝资料。本建议仅供日常穿衣参考，不构成医疗建议。</text>
      <button class="primary-button" bindtap="exitShared">按我家情况生成</button>
    </view>
  </block>
  <block wx:elif="{{sharedError}}"><empty-state title="分享内容不可用" description="{{sharedError}}" action-text="按我家情况生成" bind:action="exitShared" /></block>
  <block wx:else>
  <view wx:if="{{profile}}" class="context-summary">
    <image class="context-icon" src="/assets/icons/icon-thermometer.svg" mode="aspectFit" />
    <text class="context-primary">{{activeScene === 'outdoor' ? (noWeather ? '室外待填写' : '室外 ' + weather.currentTemp + '℃') : '室温 ' + indoorTemp + '℃'}}</text>
    <text class="context-age">· {{ageCompactText}}</text>
    <button wx:if="{{!profile.ageConfirmed}}" class="context-action" bindtap="confirmAge">确认年龄 ›</button>
    <button wx:elif="{{activeScene === 'outdoor'}}" class="context-action" bindtap="openManual">修改 ›</button>
    <button wx:else class="context-action" bindtap="openTemperature">修改 ›</button>
  </view>
  <text wx:if="{{profile && activeScene !== 'outdoor' && !environmentConfirmed}}" class="context-notice">室温为默认值，记下穿法前请确认。</text>
  <view wx:if="{{activeScene === 'outdoor' && weather}}" class="weather-summary">
    <text>{{weather.cityName}} · {{weather.weatherText}}</text>
    <button class="weather-detail-link" bindtap="toggleWeatherDetails">{{showWeatherDetails ? '收起天气' : '天气详情'}} ›</button>
  </view>
  <weather-bar wx:if="{{activeScene === 'outdoor' && showWeatherDetails}}"
    weather="{{weather}}"
    city="{{city}}"
    loading="{{loading}}"
    stale-text="{{staleText}}"
    indoor-temp="{{indoorTemp}}"
    bind:refresh="refresh"
    bind:restoreautomatic="restoreAutomatic"
    bind:choosecity="chooseCity"
    bind:manual="openManual"
    bind:opentemp="openTemperature"
  />
  <view wx:if="{{activeScene === 'outdoor' && staleText && !showWeatherDetails}}" class="weather-notice">{{staleText}}</view>
  <view wx:if="{{lastOutcomeText}}" class="last-outcome">{{lastOutcomeText}}</view>

  <block wx:if="{{loading && !recommendations}}">
    <view class="switcher-skeleton skeleton"></view>
    <view class="card-skeleton skeleton"></view>
  </block>

  <block wx:elif="{{recommendations}}">
    <view class="scene-switcher">
      <view
        wx:for="{{sceneList}}"
        wx:key="value"
        class="scene-tab scene-{{item.value}} {{activeScene === item.value ? 'active' : ''}}"
        data-scene="{{item.value}}"
        bindtap="setScene"
        role="button"
        aria-label="查看{{item.label}}建议"
      >
        <image class="scene-tab-icon" src="{{item.icon}}" mode="aspectFit" />
        <text>{{item.label}}</text>
      </view>
    </view>

    <empty-state wx:if="{{activeScene === 'outdoor' && noWeather}}" title="先确认室外温度" description="出门搭配需要室外温度；在家和睡觉可继续使用。" action-text="填写室外温度" bind:action="openManual" />
    <block wx:else>
    <recommendation-card
      item="{{recommendations[activeScene]}}"
      adjustment-label="{{adjustmentLabels[activeScene]}}"
      adopted="{{adoptedScenes[activeScene]}}"
      bind:confirm="confirmGood"
      bind:adjustopen="openAdjust"
      bind:goods="viewGoods"
    />
    <view wx:if="{{adoptedScenes[activeScene]}}" class="recorded-actions">
      <text class="recorded-title">穿后可根据宝宝的状态再调整</text>
      <view class="recorded-links">
        <button bindtap="openAfterWear">穿后观察</button>
        <button bindtap="share">保存图片</button>
        <button open-type="share">发给家人</button>
      </view>
    </view>
    </block>
  </block>

  <empty-state
    wx:else
    title="{{city ? '暂时获取不到天气' : '先选择城市或填写温度'}}"
    description="天气不可用时，也可以用手动模式生成完整建议。"
    action-text="手动填写温度"
    bind:action="openManual"
  />

  <view class="global-tip" bindtap="toggleSafety" role="button" aria-label="查看判断冷热说明">
    <image class="global-tip-icon" src="/assets/icons/icon-heart.svg" mode="aspectFit" />
    <text>判断冷热：摸后颈，温热不出汗</text>
    <text class="tip-chevron">{{showSafetyDetails ? '⌃' : '›'}}</text>
  </view>
  <text wx:if="{{showSafetyDetails}}" class="safety-details">通常摸后颈温热、不出汗，就是比较合适的状态。本建议仅供日常穿衣参考，不构成医疗建议；如宝宝出现明显不适，请及时咨询医生。</text>

  <temperature-modal visible="{{showTemperature}}" value="{{indoorTemp}}" bind:close="closeTemperature" bind:confirm="saveTemperature" />
  <share-card id="shareCard" />
  <view wx:if="{{showAdjust}}" class="action-mask" bindtap="closeAdjust">
    <view class="action-sheet" catchtap="stop">
      <text class="sheet-title">调整这套搭配</text>
      <text class="sheet-subtitle">按宝宝当前状态微调，记下后才会保存为今天的穿法。</text>
      <view class="sheet-buttons">
        <button data-delta="-1" bindtap="adjustFromSheet">想薄一点</button>
        <button data-delta="1" bindtap="adjustFromSheet">想厚一点</button>
      </view>
      <button wx:if="{{adjustments[activeScene] !== 0}}" class="sheet-link" bindtap="resetFromSheet">恢复原建议</button>
      <button class="sheet-close" bindtap="closeAdjust">完成</button>
    </view>
  </view>
  <view wx:if="{{showAfterWear}}" class="action-mask" bindtap="closeAfterWear">
    <view class="action-sheet" catchtap="stop">
      <text class="sheet-title">穿后怎么观察</text>
      <text class="sheet-subtitle">先摸宝宝后颈，结合出汗、手脚和精神状态判断。</text>
      <view class="sheet-buttons">
        <button data-tip="hot" bindtap="selectAfterWearTip">觉得热了</button>
        <button data-tip="cold" bindtap="selectAfterWearTip">觉得冷了</button>
      </view>
      <text wx:if="{{afterWearTip}}" class="after-wear-guidance">{{afterWearTip === 'hot' ? recommendations[activeScene].hotAction : recommendations[activeScene].coldAction}}</text>
      <button class="sheet-close" bindtap="closeAfterWear">知道了</button>
    </view>
  </view>
  <view wx:if="{{showGoods}}" class="goods-mask" bindtap="closeGoods"><view class="goods-sheet" catchtap="stop"><text class="goods-title">这套搭配里的衣物</text><text class="goods-current">{{recommendations[activeScene].result}}</text><text class="goods-note">图片帮助辨认款式；“/”表示可替代选择，不是全部叠穿。厚薄仍以当前建议为准。</text><scroll-view scroll-y class="goods-scroll"><view wx:for="{{currentGoods}}" wx:key="id" class="goods-row"><image src="{{item.illustration}}" mode="aspectFit"/><view><text class="goods-name">{{item.name}}</text><text>{{item.desc}}</text></view></view></scroll-view><button class="primary-button" bindtap="closeGoods">明白了，回到搭配</button></view></view>
  </block>
</view>
