<view class="page today-page">
  <view class="greeting">
    <image class="greeting-icon" src="/assets/icons/mascot-cloud.svg" mode="aspectFit" />
    <text>今天也要好好照顾宝宝哦～</text>
  </view>

  <block wx:if="{{sharedSnapshot}}">
    <view class="shared-card">
      <text class="eyebrow">家人转来的只读参考</text>
      <text class="shared-title">{{sharedSnapshot.scene === 'indoor' ? '在家' : sharedSnapshot.scene === 'outdoor' ? '出门' : '睡觉'}} · {{sharedSnapshot.date}}</text>
      <text>{{sharedSnapshot.scene === 'outdoor' ? '室外 ' + sharedSnapshot.outdoorTemp : '室温 ' + sharedSnapshot.indoorTemp}}℃ · {{sharedSnapshot.source === 'indoor' ? '室温填写' : sharedSnapshot.source === 'manual' ? '手动填写' : '自动天气'}}</text>
      <text class="shared-note">年龄段：{{sharedSnapshot.ageGroup === 'baby_0_6m' ? '0–6 个月' : sharedSnapshot.ageGroup === 'baby_6_12m' ? '6–12 个月' : '1–3 岁'}} · 请核对日期和当前温度</text><text class="shared-result">{{sharedSnapshot.result}}</text>
      <text class="shared-note">这是对方当时选定的参考，不会写入你的宝宝资料。本建议仅供日常穿衣参考，不构成医疗建议。</text>
      <button class="primary-button" bindtap="exitShared">按我家情况生成</button>
    </view>
  </block>
  <block wx:elif="{{sharedError}}"><empty-state title="分享内容不可用" description="{{sharedError}}" action-text="按我家情况生成" bind:action="exitShared" /></block>
  <block wx:else>
  <weather-bar wx:if="{{activeScene === 'outdoor'}}"
    weather="{{weather}}"
    city="{{city}}"
    loading="{{loading}}"
    stale-text="{{staleText}}"
    indoor-temp="{{indoorTemp}}"
    bind:refresh="refresh"
    bind:restoreautomatic="restoreAutomatic"
    bind:choosecity="chooseCity"
    bind:manual="openManual"
    bind:opentemp="openTemperature"
  />
  <view class="context-line"><view wx:if="{{activeScene !== 'outdoor'}}" bindtap="openTemperature" role="button">房间 {{indoorTemp}}℃ · 点击更新室温<view class="condition-time">{{environmentTime}}</view></view><view wx:if="{{activeScene === 'outdoor' && weatherTime}}" class="condition-time">{{weather.source === 'manual' ? '填写于' : '天气更新于'}} {{weatherTime}}</view><view>{{ageText}}</view><button wx:if="{{!profile.ageConfirmed}}" class="text-button" bindtap="confirmAge">确认年龄段</button></view>
  <view wx:if="{{lastOutcomeText}}" class="last-outcome">{{lastOutcomeText}}</view>

  <block wx:if="{{loading && !recommendations}}">
    <view class="switcher-skeleton skeleton"></view>
    <view class="card-skeleton skeleton"></view>
  </block>

  <block wx:elif="{{recommendations}}">
    <view class="scene-switcher">
      <view
        wx:for="{{sceneList}}"
        wx:key="value"
        class="scene-tab scene-{{item.value}} {{activeScene === item.value ? 'active' : ''}}"
        data-scene="{{item.value}}"
        bindtap="setScene"
        role="button"
        aria-label="查看{{item.label}}建议"
      >
        <image class="scene-tab-icon" src="{{item.icon}}" mode="aspectFit" />
        <text>{{item.label}}</text>
      </view>
    </view>

    <empty-state wx:if="{{activeScene === 'outdoor' && noWeather}}" title="先确认室外温度" description="出门搭配需要室外温度；在家和睡觉可继续使用。" action-text="填写室外温度" bind:action="openManual" />
    <block wx:else>
    <recommendation-card
      item="{{recommendations[activeScene]}}"
      adjustment-label="{{adjustmentLabels[activeScene]}}"
      adopted="{{adoptedScenes[activeScene]}}"
      bind:adjust="adjust"
      bind:goods="viewGoods"
    />

    <button class="adopt-button" bindtap="confirmGood">{{activeScene === 'outdoor' && noWeather ? '先填写室外温度' : adoptedScenes[activeScene] ? '已记下这套搭配' : '记下这套搭配'}}</button>
    <view class="secondary-actions"><button class="text-button" bindtap="resetScene">恢复推荐</button><button class="text-button" bindtap="share">保存图片</button><button class="share-button" disabled="{{!profile.ageConfirmed || (activeScene !== 'outdoor' && !environmentConfirmed)}}" open-type="share">
      <image class="share-icon" src="/assets/icons/icon-heart.svg" mode="aspectFit" />
      <text>发给家人</text>
    </button></view>
    </block>
  </block>

  <empty-state
    wx:else
    title="{{city ? '暂时获取不到天气' : '先选择城市或填写温度'}}"
    description="天气不可用时，也可以用手动模式生成完整建议。"
    action-text="手动填写温度"
    bind:action="openManual"
  />

  <view class="global-tip">
    <image class="global-tip-icon" src="/assets/icons/icon-heart.svg" mode="aspectFit" />
    <text>判断小窍门：摸宝宝后颈，温热、不出汗，通常就是穿对了。本建议仅供日常穿衣参考，不构成医疗建议；如宝宝出现明显不适，请及时咨询医生。</text>
  </view>

  <temperature-modal visible="{{showTemperature}}" value="{{indoorTemp}}" bind:close="closeTemperature" bind:confirm="saveTemperature" />
  <share-card id="shareCard" />
  <view wx:if="{{showGoods}}" class="goods-mask" bindtap="closeGoods"><view class="goods-sheet" catchtap="stop"><text class="goods-title">这套搭配里的衣物</text><text class="goods-current">{{recommendations[activeScene].result}}</text><text class="goods-note">图片帮助辨认款式；“/”表示可替代选择，不是全部叠穿。厚薄仍以当前建议为准。</text><scroll-view scroll-y class="goods-scroll"><view wx:for="{{currentGoods}}" wx:key="id" class="goods-row"><image src="{{item.illustration}}" mode="aspectFit" webp="{{true}}"/><view><text class="goods-name">{{item.name}}</text><text>{{item.desc}}</text></view></view></scroll-view><button class="primary-button" bindtap="closeGoods">明白了，回到搭配</button></view></view>
  </block>
</view>
