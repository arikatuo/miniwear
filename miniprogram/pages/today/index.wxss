.today-page { padding-top: 6rpx; }

.greeting {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  color: var(--color-muted);
  font-size: 25rpx;
}

.greeting-icon { width: 48rpx; height: 48rpx; }

.scene-switcher {
  display: flex;
  gap: 10rpx;
  margin: 24rpx 0;
  padding: 8rpx;
  background: var(--color-bg-deep);
  border-radius: 28rpx;
}

.scene-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0;
  border-radius: 20rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 700;
}

.scene-tab-icon { width: 40rpx; height: 40rpx; }

.scene-tab.active { background: var(--color-surface); box-shadow: var(--shadow-soft); }
.scene-tab.active.scene-indoor { color: var(--color-coral-deep); }
.scene-tab.active.scene-outdoor { color: var(--color-sky-deep); }
.scene-tab.active.scene-sleep { color: var(--color-lavender-deep); }

.adopt-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 92rpx;
  margin-top: 4rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-coral), #ff7048);
  border-radius: 26rpx;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 38rpx rgba(255, 112, 72, 0.26);
}
.secondary-actions { display: flex; gap: 16rpx; align-items: center; margin-top: 12rpx; }
.share-button, .text-button { flex: 1; min-height: 72rpx; font-size: 25rpx; border-radius: 20rpx; }
.share-button { color: var(--color-coral-deep); background: var(--color-coral-soft); }
.text-button { color: var(--color-muted); background: transparent; }
.context-line, .last-outcome { margin: 14rpx 0; padding: 16rpx 20rpx; border-radius: 16rpx; color: var(--color-muted); background: var(--color-bg-deep); font-size: 22rpx; line-height: 1.5; }
.last-outcome { color: var(--color-butter-deep); background: var(--color-butter-soft); }
.shared-card { margin-top: 24rpx; padding: 32rpx; color: var(--color-ink); background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: var(--radius-card); }
.shared-title, .shared-result, .shared-note { display: block; margin-top: 16rpx; }.shared-title { font-size: 34rpx; font-weight: 800; }.shared-result { font-size: 30rpx; font-weight: 700; }.shared-note { color: var(--color-muted); font-size: 23rpx; }

.share-icon { width: 32rpx; height: 32rpx; }

.global-tip {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: var(--color-butter-soft);
  border-radius: 26rpx;
  color: var(--color-butter-deep);
  font-size: 23rpx;
  line-height: 1.65;
}

.global-tip-icon { width: 34rpx; height: 34rpx; flex: none; margin-top: 2rpx; }

.switcher-skeleton { height: 96rpx; margin-top: 24rpx; }
.card-skeleton { height: 420rpx; margin-top: 22rpx; }
button::after { border: 0; }

.secondary-actions { gap: 8rpx; }
.share-button,.text-button { min-width: 0; padding: 0 4rpx; white-space: nowrap; font-size: 24rpx; line-height: 72rpx; }
.share-button { display: flex; align-items: center; justify-content: center; gap: 4rpx; }
.context-line { font-size: 25rpx; line-height: 1.7; }
.goods-mask { position: fixed; inset: 0; z-index: 100; background: rgba(50,40,30,.35); display: flex; align-items: flex-end; }
.goods-sheet { box-sizing: border-box; width: 100%; max-height: 85vh; padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--color-bg); }
.goods-title,.goods-current,.goods-note,.goods-name { display: block; }
.goods-title { font-size: 34rpx; font-weight: 800; }
.goods-current { margin: 16rpx 0; font-size: 28rpx; font-weight: 700; }
.goods-note { color: var(--color-muted); font-size: 24rpx; line-height: 1.6; }
.goods-scroll { max-height: 44vh; margin: 18rpx 0; }
.goods-row { display: flex; gap: 20rpx; align-items: center; padding: 16rpx 0; font-size: 24rpx; line-height: 1.5; }
.goods-row image { width: 150rpx; height: 150rpx; flex-shrink: 0; border-radius: 16rpx; }
.goods-name { font-size: 28rpx; font-weight: 700; margin-bottom: 8rpx; }
.condition-time { color: var(--color-muted); font-size: 23rpx; }
