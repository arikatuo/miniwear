.goods-page { padding-top: 0; padding-bottom: calc(132rpx + env(safe-area-inset-bottom)); }

/* ---- 吸顶区：分类 + 楼层导航 ---- */
.goods-sticky { position: sticky; z-index: 30; top: 0; margin: 0 -28rpx; padding: 20rpx 28rpx 14rpx; background: rgba(255, 249, 242, 0.94); backdrop-filter: blur(16rpx); border-bottom: 1rpx solid rgba(241, 227, 212, 0.8); }

.category-tabs { display: flex; gap: 10rpx; padding: 8rpx; background: var(--color-bg-deep); border-radius: 30rpx; }

.category-tabs button {
  display: flex;
  flex: 1 1 0;
  width: 0 !important;
  min-height: 96rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 0;
  margin-bottom: 0;
  padding: 0 8rpx !important;
  color: var(--color-muted);
  background: transparent;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.2;
}

.tab-icon { width: 46rpx; height: 46rpx; flex: none; opacity: 0.6; }
.tab-copy { display: flex; flex-direction: column; align-items: flex-start; }
.tab-title { font-size: 28rpx; font-weight: 800; }
.tab-desc { margin-top: 2rpx; color: var(--color-faint); font-size: 22rpx; font-weight: 650; }
.category-tabs button.active { color: var(--color-ink); background: var(--color-surface); box-shadow: var(--shadow-soft); }
.category-tabs button.active .tab-icon { opacity: 1; }
.category-tabs button.active .tab-desc { color: var(--color-muted); }

.floor-nav { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.floor-nav .floor { display: inline-flex; align-items: center; gap: 8rpx; min-height: 68rpx; margin: 0 12rpx 0 0; padding: 0 24rpx; color: var(--color-muted); background: var(--color-surface); border: 1.5rpx solid var(--color-border); border-radius: 999rpx; font-size: 26rpx; font-weight: 700; transition: background-color 200ms ease, color 200ms ease; }
.floor-nav .floor:last-child { margin-right: 4rpx; }
.floor-nav .floor.current { color: #ffffff; background: linear-gradient(135deg, #F47A52 0%, #E5593A 100%); border-color: transparent; }
.floor-count { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; background: var(--color-bg-deep); border-radius: 999rpx; color: var(--color-muted); font-size: 20rpx; font-weight: 700; line-height: 34rpx; text-align: center; }
.floor.current .floor-count { color: #ffffff; background: rgba(255, 255, 255, 0.3); }

.notice { display: flex; align-items: center; gap: 12rpx; margin: 22rpx 0 22rpx; padding: 18rpx 22rpx; color: var(--color-butter-ink); background: var(--color-butter-tint); border: 1rpx solid var(--color-butter-soft); border-radius: 24rpx; font-size: 24rpx; line-height: 1.6; }
.notice-icon { width: 34rpx; height: 34rpx; flex: none; }

/* ---- 分组 + 三列网格（Flexbox，避开真机 Grid 兼容风险） ---- */
.goods-group { margin-bottom: 22rpx; padding: 26rpx 22rpx 10rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: var(--radius-card); box-shadow: var(--shadow-soft); scroll-margin-top: 220rpx; }
.group-head { display: flex; align-items: baseline; gap: 12rpx; padding: 0 6rpx 20rpx; }
.group-title { color: var(--color-ink); font-size: 32rpx; font-weight: 800; }
.group-count { color: var(--color-muted); font-size: 23rpx; }

.goods-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.goods-card { display: flex; width: calc((100% - 28rpx) / 3); flex-direction: column; margin-bottom: 14rpx; }
.goods-card:active .goods-thumb { transform: scale(0.97); }
.goods-thumb { display: flex; align-items: center; justify-content: center; width: 100%; padding: 10rpx; background: var(--color-surface-soft); border: 1.5rpx solid var(--color-border); border-radius: 28rpx; transition: transform 160ms ease; }
.goods-image { width: 100%; height: 170rpx; border-radius: 20rpx; }
.image-missing { display: flex; align-items: center; justify-content: center; color: var(--color-faint); font-size: 22rpx; }
.goods-name { display: block; margin-top: 12rpx; overflow: hidden; color: var(--color-ink); font-size: 26rpx; font-weight: 750; line-height: 1.3; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.goods-warm { align-self: center; margin-top: 6rpx; padding: 2rpx 14rpx; color: var(--color-butter-ink); background: var(--color-butter-tint); border-radius: 999rpx; font-size: 21rpx; font-weight: 650; }

/* ---- 详情弹层 ---- */
.detail-head { display: flex; align-items: center; gap: 24rpx; }
.detail-thumb { display: flex; width: 188rpx; height: 188rpx; flex: none; align-items: center; justify-content: center; background: var(--color-surface); border: 1.5rpx solid var(--color-border); border-radius: 36rpx; }
.detail-image { width: 164rpx; height: 164rpx; border-radius: 28rpx; }
.detail-meta { min-width: 0; }
.detail-title, .detail-warm, .detail-desc, .detail-note { display: block; }
.detail-title { color: var(--color-ink); font-size: 38rpx; font-weight: 800; line-height: 1.25; }
.detail-warm { display: inline-block; margin-top: 12rpx; padding: 4rpx 18rpx; color: var(--color-butter-ink); background: var(--color-butter-soft); border-radius: 999rpx; font-size: 24rpx; font-weight: 750; }
.detail-desc { margin-top: 24rpx; color: var(--color-ink); font-size: 28rpx; line-height: 1.7; }
.variant-list { margin-top: 20rpx; padding: 20rpx 22rpx; background: var(--color-surface); border: 1rpx solid var(--color-border); border-radius: 24rpx; }
.variant-title, .variant-item { display: block; }
.variant-title { margin-bottom: 6rpx; color: var(--color-ink); font-size: 25rpx; font-weight: 750; }
.variant-item { color: var(--color-muted); font-size: 24rpx; line-height: 1.7; }
.detail-note { margin-top: 18rpx; color: var(--color-muted); font-size: 24rpx; }
.detail-close { margin-top: 22rpx; }
