.overlay { position: fixed; z-index: 110; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(74, 59, 48, .5); }
.panel { width: 100%; max-height: 92vh; padding: 28rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); background: var(--color-surface); border-radius: 40rpx 40rpx 0 0; }
.panel-head { display: flex; align-items: center; justify-content: space-between; }
.title { color: var(--color-ink); font-size: 34rpx; font-weight: 750; }
.close { min-width: 96rpx; min-height: 70rpx; margin: 0; padding: 0; color: var(--color-muted); background: var(--color-surface-soft); border: 1.5rpx solid var(--color-border); border-radius: 18rpx; font-size: 25rpx; line-height: 70rpx; }
.preview { height: 720rpx; margin-top: 20rpx; overflow: hidden; background: var(--color-bg); border-radius: 28rpx; text-align: center; }
.image { width: 100%; }
.loading { display: flex; height: 720rpx; align-items: center; justify-content: center; color: var(--color-muted); font-size: 26rpx; }
.canvas { position: fixed; left: -9999px; width: 600px; height: 900px; }
.save { min-height: 90rpx; margin-top: 22rpx; color: #ffffff; background: linear-gradient(135deg, var(--color-coral), #ff7048); border-radius: 24rpx; font-size: 29rpx; font-weight: 700; line-height: 90rpx; }
.note { display: block; margin-top: 14rpx; color: var(--color-faint); font-size: 23rpx; text-align: center; }
button::after { border: 0; }
