<view wx:if="{{visible}}" class="overlay" bindtap="close">
  <view class="panel" catchtap="stop">
    <view class="panel-head">
      <text class="title">分享给家人</text>
      <button class="close" bindtap="close" aria-label="关闭分享卡">关闭</button>
    </view>
    <view class="preview">
      <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="widthFix" class="image" />
      <view wx:else class="loading">{{generating ? '正在生成建议卡…' : '准备生成…'}}</view>
    </view>
    <canvas canvas-id="shareCanvas" class="canvas"></canvas>
    <button class="save" bindtap="save" disabled="{{!imagePath}}">保存图片</button>
    <text class="note">分享前请再次结合宝宝实际状态判断。</text>
  </view>
</view>
