<view class="weather-shell">
  <view class="combo-card">
    <view class="combo-half weather-half" bindtap="chooseCity" role="button" aria-label="选择城市">
      <block wx:if="{{loading && !weather}}">
        <view class="combo-icon-wrap"><view class="spinner"></view></view>
        <view class="combo-body">
          <view class="combo-topline">
            <text class="combo-label">正在看看天气…</text>
          </view>
        </view>
      </block>
      <block wx:elif="{{weather}}">
        <view class="combo-icon-wrap">
          <image class="combo-icon" src="{{weatherIcon}}" mode="aspectFit" />
        </view>
        <view class="combo-body">
          <view class="combo-topline">
            <text class="combo-label">{{weather.cityName}}{{sourceLabel ? ' · ' + sourceLabel : ''}}</text>
            <text class="combo-action city-action">改城市 ›</text>
          </view>
          <view class="combo-mainline">
            <text class="combo-value">{{weather.source === 'example' ? '待填写' : weather.currentTemp + '℃'}}</text>
          </view>
          <text wx:if="{{showRange}}" class="combo-range">{{weather.minTemp}}-{{weather.maxTemp}}℃</text>
        </view>
      </block>
      <block wx:else>
        <view class="combo-icon-wrap muted">
          <image class="combo-icon" src="/assets/icons/weather-cloud.svg" mode="aspectFit" />
        </view>
        <view class="combo-body">
          <view class="combo-topline">
            <text class="combo-label">{{city ? '暂时没有天气' : '选择城市'}}</text>
          </view>
          <view class="combo-mainline">
            <text class="combo-value small">点击设置 ›</text>
          </view>
        </view>
      </block>
    </view>

    <view class="combo-divider"></view>

    <view class="combo-half temp-half" bindtap="openTemperature" role="button" aria-label="修改室内温度">
      <view class="combo-icon-wrap warm">
        <image class="combo-icon" src="/assets/icons/icon-thermometer.svg" mode="aspectFit" />
      </view>
      <view class="combo-body">
        <view class="combo-topline">
          <text class="combo-label">室温</text>
          <text class="combo-action">改 ›</text>
        </view>
        <view class="combo-mainline">
          <text class="combo-value">{{indoorTemp}}℃</text>
        </view>
      </view>
    </view>
  </view>

  <view class="combo-footer">
    <text class="stale">{{staleText}}</text>
    <view class="footer-links">
      <button wx:if="{{isManual}}" class="link-button" bindtap="restoreAutomatic" loading="{{loading}}" disabled="{{loading}}">恢复实时天气</button>
      <button wx:else class="link-button" bindtap="refresh" loading="{{loading}}" disabled="{{loading}}">刷新天气</button>
      <button class="link-button" bindtap="manual">改天气</button>
    </view>
  </view>
</view>
