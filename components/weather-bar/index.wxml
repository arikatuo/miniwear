<view class="weather-shell">
  <view wx:if="{{loading && !weather}}" class="weather-loading">正在看看今天的天气…</view>
  <block wx:elif="{{weather}}">
    <view class="weather-main">
      <view>
        <view class="city-line" bindtap="chooseCity" role="button" aria-label="选择城市">
          <text class="city">{{weather.cityName || city.name}}</text>
          <text class="chevron">›</text>
        </view>
        <text class="weather-detail">{{weather.weatherText}} · {{weather.currentTemp}}℃ · {{weather.minTemp}}-{{weather.maxTemp}}℃</text>
      </view>
      <button class="refresh" bindtap="refresh" loading="{{loading}}" disabled="{{loading}}" aria-label="刷新天气">刷新</button>
    </view>
    <view wx:if="{{staleText}}" class="stale">{{staleText}}</view>
  </block>
  <view wx:else class="empty-weather">
    <view>
      <text class="empty-title">{{city ? '暂时没有天气数据' : '还没有选择城市'}}</text>
      <text class="empty-copy">可以选择城市，或直接手动填写温度。</text>
    </view>
    <button class="mini-button" bindtap="chooseCity">选城市</button>
  </view>
  <button class="manual-link" bindtap="manual">手动填写温度</button>
</view>
