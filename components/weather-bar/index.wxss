.weather-shell {
  padding: 26rpx;
  background: linear-gradient(145deg, #e9f4ff, #f5faff);
  border: 1rpx solid #d7e9f8;
  border-radius: 28rpx;
}
.weather-main, .empty-weather {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.city-line { display: flex; align-items: center; min-height: 52rpx; }
.city { font-size: 34rpx; font-weight: 700; color: #253342; }
.chevron { margin-left: 8rpx; color: #3478b9; font-size: 40rpx; }
.weather-detail, .empty-copy { display: block; color: #607487; font-size: 25rpx; }
.empty-title { display: block; font-size: 30rpx; font-weight: 650; color: #253342; }
.refresh, .mini-button {
  min-width: 112rpx;
  min-height: 72rpx;
  margin: 0;
  color: #3478b9;
  background: #ffffff;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 72rpx;
}
.manual-link {
  min-height: 68rpx;
  margin: 12rpx 0 -12rpx auto;
  padding: 0;
  color: #3478b9;
  background: transparent;
  font-size: 25rpx;
  line-height: 68rpx;
  text-align: right;
}
.weather-loading { min-height: 90rpx; color: #607487; line-height: 90rpx; }
.stale { margin-top: 14rpx; padding: 10rpx 14rpx; color: #915c32; background: #fff0e5; border-radius: 12rpx; font-size: 23rpx; }
button::after { border: 0; }
