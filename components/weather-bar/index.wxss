.weather-shell {
  padding: 24rpx;
  background: linear-gradient(150deg, var(--color-sky-soft), var(--color-surface));
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
}

.weather-main, .empty-weather {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.weather-icon-wrap {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  background: var(--color-sky-soft);
  border-radius: 26rpx;
}

.weather-icon-wrap.muted {
  background: var(--color-bg-deep);
  box-shadow: none;
}

.weather-icon {
  width: 64rpx;
  height: 64rpx;
}

.weather-info {
  flex: 1;
  min-width: 0;
}

.city-line { display: flex; align-items: center; min-height: 48rpx; gap: 4rpx; }
.pin-icon { width: 26rpx; height: 26rpx; margin-right: 2rpx; }
.city { color: var(--color-ink); font-size: 33rpx; font-weight: 750; }
.chevron { margin-left: 4rpx; color: var(--color-sky-deep); font-size: 36rpx; }
.weather-detail, .empty-copy { display: block; margin-top: 2rpx; color: var(--color-muted); font-size: 24rpx; }
.empty-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--color-ink); }

.refresh, .mini-button {
  min-width: 112rpx;
  min-height: 72rpx;
  margin: 0;
  flex: none;
  color: var(--color-sky-deep);
  background: var(--color-surface);
  border-radius: 20rpx;
  font-size: 25rpx;
  line-height: 72rpx;
  box-shadow: var(--shadow-soft);
}

.manual-link {
  min-height: 64rpx;
  margin: 10rpx 0 -10rpx auto;
  padding: 0;
  color: var(--color-sky-deep);
  background: transparent;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: right;
}

.weather-loading {
  display: flex;
  min-height: 96rpx;
  align-items: center;
  gap: 16rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}

.spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid var(--color-sky-soft);
  border-top-color: var(--color-sky);
  border-radius: 50%;
  animation: spin 800ms linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.stale {
  margin-top: 14rpx;
  padding: 10rpx 16rpx;
  color: var(--color-butter-deep);
  background: var(--color-butter-soft);
  border-radius: 16rpx;
  font-size: 23rpx;
}

button::after { border: 0; }
