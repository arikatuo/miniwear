.empty { padding: 50rpx 32rpx; text-align: center; }
.mascot { width: 320rpx; height: 226rpx; margin: 0 auto 16rpx; }
.title, .description { display: block; }
.title { color: var(--color-ink); font-size: 32rpx; font-weight: 700; }
.description { margin-top: 10rpx; color: var(--color-muted); font-size: 26rpx; line-height: 1.6; }
.action { min-height: 84rpx; margin-top: 28rpx; color: #ffffff; background: linear-gradient(135deg, var(--color-coral), #ff7048); border-radius: 24rpx; font-size: 28rpx; font-weight: 700; line-height: 84rpx; }
button::after { border: 0; }
