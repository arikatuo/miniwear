<view wx:if="{{item}}" class="recommend-card scene-{{item.scene}}">
  <view class="card-head">
    <view class="tag temp-tag">
      <image class="tag-icon" src="{{sceneIcon}}" mode="aspectFit" />
      <text>{{tempLabel}} {{item.temperature}}℃</text>
    </view>
    <text class="tag age-tag">{{item.ageText}}</text>
    <text wx:if="{{adjustmentLabel}}" class="tag adjust-tag">{{adjustmentLabel}}</text>
  </view>

  <text class="result">{{item.result}}</text>
  <text class="reason">{{item.reason}}</text>

  <view class="tip-toggle-row">
    <view class="tip-toggle tip-hot {{expandedTip === 'hot' ? 'open' : ''}}" data-tip="hot" bindtap="toggleTip">
      <image class="tip-toggle-icon" src="/assets/icons/weather-hot.svg" mode="aspectFit" />
      <text>热了怎么办</text>
    </view>
    <view class="tip-toggle tip-cold {{expandedTip === 'cold' ? 'open' : ''}}" data-tip="cold" bindtap="toggleTip">
      <image class="tip-toggle-icon" src="/assets/icons/weather-cold.svg" mode="aspectFit" />
      <text>冷了怎么办</text>
    </view>
  </view>
  <view wx:if="{{expandedTip === 'hot'}}" class="tip-expanded tip-expanded-hot">{{item.hotAction}}</view>
  <view wx:if="{{expandedTip === 'cold'}}" class="tip-expanded tip-expanded-cold">{{item.coldAction}}</view>

  <view class="actions">
    <button class="adjust-button" data-delta="-1" bindtap="adjust">想薄一点</button>
    <button class="good-button" bindtap="confirmGood">
      <image class="good-icon" src="/assets/icons/icon-check.svg" mode="aspectFit" />
      <text>刚刚好</text>
    </button>
    <button class="adjust-button" data-delta="1" bindtap="adjust">想厚一点</button>
  </view>
</view>
