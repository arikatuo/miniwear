.recommend-card {
  margin-bottom: 24rpx;
  padding: 30rpx 28rpx 28rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-lift);
}

.card-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 750;
}

.temp-tag { color: var(--scene-deep); background: var(--scene-soft); }
.tag-icon { width: 28rpx; height: 28rpx; }
.age-tag { color: var(--color-faint); background: var(--color-bg-deep); }
.adjust-tag { color: var(--color-butter-deep); background: var(--color-butter-soft); }

.illustration-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
}

.illustration-thumb {
  position: relative;
  display: flex;
  width: 116rpx;
  height: 116rpx;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: var(--scene-soft);
  border-radius: 28rpx;
}

.illustration-img { width: 76rpx; height: 76rpx; }

.gauge {
  display: flex;
  gap: 4rpx;
}

.gauge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.6);
}

.gauge-dot.filled { background: var(--scene-deep); }

.illustration-text { flex: 1; min-width: 0; }

.result {
  display: block;
  color: var(--color-ink);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.28;
}

.reason {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-muted);
  font-size: 24rpx;
  line-height: 1.5;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.tip-toggle-row {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.tip-toggle {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 68rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.tip-toggle-icon { width: 30rpx; height: 30rpx; }

.tip-hot { color: var(--color-coral-deep); background: var(--color-coral-soft); }
.tip-cold { color: var(--color-sky-deep); background: var(--color-sky-soft); }
.tip-hot.open, .tip-cold.open { box-shadow: inset 0 0 0 2rpx currentColor; }

.tip-expanded {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  color: var(--color-ink);
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 18rpx;
}

.tip-expanded-hot { background: var(--color-coral-soft); }
.tip-expanded-cold { background: var(--color-sky-soft); }

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.adjust-button,
.good-button {
  flex: 1;
  min-height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.adjust-button {
  color: var(--scene-deep);
  background: var(--scene-soft);
}

.good-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-mint), var(--color-mint-deep));
  line-height: 1;
}

.good-icon { width: 30rpx; height: 30rpx; }

button::after { border: 0; }
