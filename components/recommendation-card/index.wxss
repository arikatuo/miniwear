.recommend-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  background: #ffffff;
  border: 1rpx solid rgba(52, 120, 185, 0.08);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(50, 92, 126, 0.07);
}
.card-head { display: flex; align-items: center; justify-content: space-between; }
.scene-badge { padding: 8rpx 18rpx; color: #3478b9; background: #e9f3fc; border-radius: 999rpx; font-size: 25rpx; font-weight: 650; }
.temperature { color: #718096; font-size: 25rpx; }
.result { display: block; margin: 22rpx 0 8rpx; color: #253342; font-size: 38rpx; font-weight: 700; line-height: 1.35; }
.adjust-label { display: inline-block; margin-bottom: 14rpx; padding: 6rpx 14rpx; color: #3478b9; background: #eef7ff; border-radius: 10rpx; font-size: 23rpx; }
.detail { margin-top: 22rpx; padding: 22rpx; background: #f7fafc; border-radius: 20rpx; }
.detail-label, .tip-label { display: block; margin-bottom: 6rpx; color: #34495e; font-weight: 650; }
.detail-copy, .age-copy { display: block; color: #607487; font-size: 25rpx; line-height: 1.65; }
.age-copy { margin-top: 10rpx; }
.tips { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 18rpx; }
.tip { padding: 20rpx; border-radius: 18rpx; color: #596b7b; font-size: 24rpx; line-height: 1.55; }
.tip-hot { background: #fff6dc; }
.tip-cold { background: #eaf5ff; }
.actions { display: flex; gap: 12rpx; margin-top: 24rpx; }
.actions button { flex: 1; min-height: 82rpx; margin: 0; padding: 0 8rpx; border-radius: 18rpx; font-size: 24rpx; line-height: 82rpx; }
.adjust-button { color: #3e5366; background: #f2f6f9; }
.good-button { color: #2d7650; background: #e7f6ed; }
button::after { border: 0; }
button:active { opacity: .8; transform: scale(.98); }
