.recommend-card {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx 26rpx;
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.scene-icon-wrap {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  background: var(--scene-soft);
  border-radius: 26rpx;
}

.scene-icon {
  width: 58rpx;
  height: 58rpx;
}

.head-text {
  flex: 1;
  min-width: 0;
}

.scene-name {
  display: block;
  color: var(--scene-deep);
  font-size: 30rpx;
  font-weight: 750;
}

.temperature {
  display: block;
  margin-top: 2rpx;
  color: var(--color-faint);
  font-size: 24rpx;
}

.adjust-tag {
  flex: none;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-butter-soft);
  color: var(--color-butter-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.result {
  display: block;
  margin-top: 22rpx;
  color: var(--color-ink);
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.35;
}

.detail {
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  background: var(--color-surface-soft);
  border-radius: 24rpx;
}

.detail-copy {
  display: block;
  color: var(--color-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.age-copy {
  display: block;
  margin-top: 8rpx;
  color: var(--color-faint);
  font-size: 23rpx;
}

.tips {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.tip {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 22rpx;
}

.tip-hot {
  background: var(--color-coral-soft);
}

.tip-cold {
  background: var(--color-sky-soft);
}

.tip-icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 2rpx;
  flex: none;
}

.tip-text {
  flex: 1;
  min-width: 0;
}

.tip-label {
  display: block;
  color: var(--color-ink);
  font-size: 23rpx;
  font-weight: 700;
}

.tip-copy {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.adjust-button,
.good-button {
  flex: 1;
  min-height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.adjust-button {
  color: var(--scene-deep);
  background: var(--scene-soft);
}

.good-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #ffffff;
  background: linear-gradient(135deg, var(--color-mint), var(--color-mint-deep));
  line-height: 1;
}

.good-icon {
  width: 30rpx;
  height: 30rpx;
}

button::after {
  border: 0;
}
