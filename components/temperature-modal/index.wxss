.overlay { position: fixed; z-index: 100; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(74, 59, 48, .45); }
.sheet { width: 100%; padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); background: var(--color-surface); border-radius: 40rpx 40rpx 0 0; }
.handle { width: 72rpx; height: 8rpx; margin: 0 auto 22rpx; background: var(--color-border); border-radius: 99rpx; }

.sheet-head { display: flex; align-items: center; gap: 18rpx; }
.head-icon { width: 64rpx; height: 64rpx; flex: none; }
.title, .copy { display: block; }
.title { color: var(--color-ink); font-size: 34rpx; font-weight: 750; }
.copy { margin-top: 4rpx; color: var(--color-muted); font-size: 24rpx; }

.readout { display: flex; align-items: flex-start; justify-content: center; margin: 24rpx 0 18rpx; color: var(--color-coral-deep); font-weight: 800; line-height: 1; }
.readout-value { font-size: 88rpx; }
.readout-unit { margin-top: 12rpx; font-size: 32rpx; }

.choices { display: flex; gap: 12rpx; margin-bottom: 22rpx; }
.choice { flex: 1; min-height: 74rpx; margin: 0; padding: 0; color: var(--color-muted); background: var(--color-surface-soft); border: 1.5rpx solid var(--color-border); border-radius: 20rpx; font-size: 25rpx; line-height: 70rpx; }
.choice.active { color: #ffffff; background: linear-gradient(135deg, var(--color-coral), #ff7048); border-color: transparent; }

.input-row { display: flex; align-items: center; gap: 16rpx; padding: 0 22rpx; background: var(--color-surface-soft); border: 1.5rpx solid var(--color-border); border-radius: 22rpx; }
.input { flex: 1; min-height: 84rpx; font-size: 32rpx; color: var(--color-ink); }
.confirm, .cancel { min-height: 88rpx; border-radius: 24rpx; font-size: 29rpx; line-height: 88rpx; }
.confirm { margin-top: 24rpx; color: #ffffff; background: linear-gradient(135deg, var(--color-coral), #ff7048); }
.cancel { color: var(--color-muted); background: transparent; }
button::after { border: 0; }
